---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import KeyFeatures from "../components/KeyFeatures.astro";
import MediaShowcase from "../components/MediaShowcase.astro";

// REDESIGN. Media = grå placeholders. Copy engelsk.
const recording = [
  { label: "Screen & window", body: "Capture your whole display, a single window, or a region — at full resolution." },
  { label: "Camera & mic", body: "Add a webcam bubble and crisp audio. Anchor it anywhere, resize on the fly." },
  { label: "iPhone & devices", body: "Plug in your iPhone and record it right alongside your Mac — one synced take." },
];
const editing = [
  { label: "Auto-zoom", body: "Dolly follows your cursor and zooms where it matters. Every zoom stays editable." },
  { label: "Backdrops & framing", body: "Rounded corners, padding, and a soft shadow over a backdrop of your choice." },
  { label: "Timeline & export", body: "Trim, tweak, and export a share-ready video — presets for every platform." },
];
---

<Layout>
  <Nav />

  <main>
    <!-- Hero -->
    <section class="pt-24 pb-20 text-center md:pt-32">
      <Container>
        <img
          src="/dolly-logo-single.svg"
          alt="Dolly"
          class="mx-auto h-8 w-8 [filter:invert(1)]"
        />
        <h1
          data-reveal
          class="mx-auto mt-8 max-w-3xl text-4xl leading-[1.05] tracking-[-0.01em] text-text sm:text-5xl"
        >
          Production-grade screen demos.
        </h1>
        <p
          data-reveal
          class="mx-auto mt-5 max-w-xl text-base text-text-muted sm:text-lg"
        >
          Record, zoom, and polish screen recordings automatically. Natively and
          locally on your Mac.
        </p>

        <!-- Hero-video (placeholder) -->
        <div class="mt-14 aspect-video w-full rounded-lg bg-surface"></div>
      </Container>
    </section>

    <!-- Key features -->
    <KeyFeatures />

    <!-- Recording -->
    <MediaShowcase
      title="Record anything."
      body="Screen, camera, mic, system audio — even your iPhone. One take, zero setup."
      items={recording}
    />

    <!-- Editing -->
    <MediaShowcase
      title="Polished in seconds."
      body="Auto-zoom, backdrops, and smooth motion — Dolly does the polish, you keep control."
      items={editing}
    />
  </main>

  <Footer />
</Layout>

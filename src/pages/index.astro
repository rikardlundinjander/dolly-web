---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import FeatureRow from "../components/FeatureRow.astro";
import StepPlayer from "../components/StepPlayer.astro";

// Fas 2 — full landningssida. Media = platshållare (video kommer senare).
// Copy engelsk (produkten är engelsk-native). PLATSHÅLLAR-PRIS nedan.
// Alla tre pekar på samma placeholder tills vi har per-steg-videor.
const STEP_VIDEO = "/KH_web_placeholder_herovid.mp4";
const steps = [
  { title: "Record", body: "Capture a window, a region, or the full screen — with your webcam, if you like.", src: STEP_VIDEO },
  { title: "Dolly polishes", body: "Auto-zoom, backdrop, and cursor smoothing apply while you record.", src: STEP_VIDEO },
  { title: "Export", body: "Trim, tweak, and export a share-ready video in seconds.", src: STEP_VIDEO },
];

const grid = [
  { title: "Webcam bubble", body: "Record your camera alongside the screen, anchored anywhere." },
  { title: "Annotations", body: "Pin text and callouts that follow the frame." },
  { title: "Intro & outro", body: "Add clean opening and closing motion with easing you control." },
  { title: "Trim & timeline", body: "A magnetic timeline for cuts, zooms, and effects." },
  { title: "One-click export", body: "Presets for the platforms you actually post to." },
  { title: "Stays on your Mac", body: "Dolly runs entirely on-device. Nothing leaves your machine." },
];

const faqs = [
  { q: "Is Dolly a subscription?", a: "No. Dolly is a one-time purchase that includes 12 months of updates. Keep the version you bought for as long as you like." },
  { q: "Which macOS versions are supported?", a: "macOS 15 (Sequoia) and later." },
  { q: "Where are my recordings stored?", a: "Locally, on your Mac. Dolly runs entirely on-device — nothing is uploaded." },
  { q: "How do updates work?", a: "Dolly updates itself automatically. Your 12 months of updates begin at purchase." },
  { q: "Can I get a refund?", a: "Yes — checkout and refunds are handled by Polar, our payment provider." },
];
---

<Layout>
  <!-- Vit innehållsyta som lyfter av den fixed footern (footer-reveal) -->
  <div id="page" class="relative z-10 overflow-x-clip rounded-b-[2rem] bg-bg pb-24">
    <Nav />

    <!-- Hero -->
    <Container class="flex flex-col items-center pt-24 text-center">
      <div id="hero-app-icon" class="mb-8 size-[72px] overflow-hidden rounded-[24px] shadow-[0_4px_6.72px_-1px_rgba(0,0,0,0.14),0_2px_4.48px_-2px_rgba(0,0,0,0.14)]">
        <img
          src="/dolly-app-icon.svg"
          alt="Dolly app icon"
          width="64"
          height="64"
          class="size-full"
        />
      </div>

      <h1
        class="max-w-4xl font-display text-5xl font-bold leading-[1.02] tracking-[-0.03em] text-text sm:text-6xl"
      >
        Beautiful screen recordings, natively on Mac.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-text-muted">
        Dolly records, zooms, and polishes automatically. Nothing to configure —
        export in seconds.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#pricing"
          class="rounded-pill bg-btn-primary px-6 py-3 text-sm font-medium text-btn-primary-text shadow-xs transition-colors duration-[var(--duration-fast)] ease-[var(--ease-out-quart)] hover:bg-btn-primary-hover"
        >
          Download for Mac
        </a>
        <a
          href="#demo"
          class="rounded-pill border border-border-strong bg-bg px-6 py-3 text-sm font-medium text-text shadow-xs transition-colors duration-[var(--duration-fast)] hover:bg-surface"
        >
          Watch the demo →
        </a>
      </div>
      <p class="mt-4 text-sm text-text-subtle">
        7-day trial · Requires macOS 15 or later · One-time purchase
      </p>

      <!-- Hero-video: startar i containerbredd, skalas upp vid scroll -->
      <div id="demo" class="mt-16 w-full scroll-mt-24">
        <video
          id="hero-video"
          class="aspect-video w-full origin-top rounded-xl bg-surface object-cover will-change-transform"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        >
          <source src="/KH_web_placeholder_herovid.mp4" type="video/mp4" />
        </video>
      </div>
    </Container>

    <!-- Feature-rader -->
    <Section id="features">
      <div class="flex flex-col gap-10">
        <FeatureRow
          kicker="Auto-zoom"
          title="Zoom that follows the action."
          body="Dolly watches your cursor and zooms in where it matters — automatically. Every zoom stays editable on the timeline."
        />
        <FeatureRow
          kicker="Backdrops"
          title="Instantly presentable."
          body="Rounded corners, padding, and a soft shadow over a backdrop of your choice. Raw capture in, designed output out."
          reverse
        />
        <FeatureRow
          kicker="Cursor"
          title="A pointer worth watching."
          body="Dolly re-renders a smoothed cursor from recorded metadata — deliberate motion, none of the jitter."
        />
      </div>
    </Section>

    <!-- Så funkar det -->
    <Section
      kicker="How it works"
      title="From rec to ready."
    >
      <StepPlayer steps={steps} />
    </Section>

    <!-- Feature-grid -->
    <Section
      title="Everything in the box."
      lead="No add-ons, no upsells. One app that does the whole job."
    >
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          grid.map((f, i) => (
            <div
              data-reveal
              style={`--reveal-delay:${(i % 3) * 80}ms`}
              class="rounded-lg bg-surface p-6"
            >
              <p class="text-base font-semibold text-text">{f.title}</p>
              <p class="mt-2 text-sm text-text-muted">{f.body}</p>
            </div>
          ))
        }
      </div>
    </Section>

    <!-- Pricing -->
    <Section
      id="pricing"
      kicker="Pricing"
      title="Pay once. It's yours."
      lead="No subscription. One-time purchase with 12 months of updates included."
    >
      <div data-reveal class="mx-auto max-w-md rounded-2xl bg-surface p-8 sm:p-10">
        <p class="text-base font-semibold text-text">Dolly</p>
        <p class="mt-1 text-sm text-text-muted">One-time purchase</p>
        <div class="mt-6 flex items-baseline gap-2">
          <span class="font-display text-5xl font-bold tracking-tight text-text">$69</span>
          <span class="text-sm text-text-muted">once</span>
        </div>
        <a
          href="https://buy.polar.sh/polar_cl_twiEvKa2nqt7k2bPyNEMGlCkmiZydNOUvPIyU105wyO"
          class="mt-8 block rounded-pill bg-btn-primary py-3 text-center text-sm font-medium text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
        >
          Buy now
        </a>
        <p class="mt-3 text-center text-xs text-text-subtle">Secure checkout via Polar</p>
        <ul class="mt-8 flex flex-col gap-3 text-sm text-text-muted">
          <li>12 months of updates</li>
          <li>All features included</li>
          <li>Runs entirely on your Mac</li>
          <li>Requires macOS 15 or later</li>
        </ul>
      </div>
    </Section>

    <!-- FAQ -->
    <Section id="faq" title="Questions?">
      <div data-reveal class="mx-auto max-w-2xl divide-y divide-border">
        {
          faqs.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-medium text-text marker:content-none">
                {item.q}
                <span class="text-text-subtle transition-transform duration-[var(--duration-fast)] group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-3 max-w-xl text-sm text-text-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </Section>

    <!-- Slut-CTA -->
    <Section>
      <div data-reveal class="flex flex-col items-center text-center">
        <h2
          class="max-w-2xl font-display text-4xl font-bold tracking-[-0.025em] text-text sm:text-5xl"
        >
          Make your next recording look designed.
        </h2>
        <a
          href="#pricing"
          class="mt-8 rounded-pill bg-btn-primary px-6 py-3 text-sm font-medium text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
        >
          Download for Mac
        </a>
      </div>
    </Section>
  </div>

  <Footer />
</Layout>

<script>
  // Hero-video skalas upp när man scrollar (respekterar reduced-motion).
  // origin-top => växer nedåt; vi reserverar lika mycket margin-bottom så
  // sektionen under pushas ned istället för att krockas.
  const video = document.getElementById("hero-video");
  const demo = document.getElementById("demo");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (video && demo && !reduce) {
    const MAX = 1.22; // hur mycket den växer
    const DIST = 520; // px scroll tills full uppskalning
    let h = video.offsetHeight; // olayoutad höjd (opåverkad av transform)
    let ticking = false;
    const update = () => {
      const p = Math.min(Math.max(window.scrollY, 0) / DIST, 1);
      const scale = 1 + p * (MAX - 1);
      video.style.transform = `scale(${scale.toFixed(4)})`;
      demo.style.marginBottom = ((scale - 1) * h).toFixed(1) + "px";
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener(
      "resize",
      () => {
        h = video.offsetHeight;
        update();
      },
      { passive: true },
    );
    update();
    addEventListener("scroll", onScroll, { passive: true });
  }

  // Pausa hero-videon när den är utanför vyn (performance)
  if (video && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0 },
    );
    io.observe(video);
  }
</script>

<script>
  // Footer-reveal: reservera exakt footerns höjd under sidan så den fixed
  // footern avslöjas när innehållet lyft av den vid botten.
  const page = document.getElementById("page");
  const footer = document.querySelector("footer");
  if (page && footer) {
    const setSpace = () => {
      page.style.marginBottom = footer.offsetHeight + "px";
    };
    setSpace();
    addEventListener("resize", setSpace, { passive: true });
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(setSpace);
    }
  }
</script>

---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Usps from "../components/Usps.astro";
import MediaShowcase from "../components/MediaShowcase.astro";
import Audience from "../components/Audience.astro";
import FineTune from "../components/FineTune.astro";
import Pricing from "../components/Pricing.astro";
import FAQ from "../components/FAQ.astro";
import { getDownloadUrl } from "../lib/links";

// REDESIGN. Media = grå placeholders. Copy engelsk.
const DMG = await getDownloadUrl(); // senaste DMG från appcasten
const recording = [
  { label: "Screen & window", body: "Capture your whole display, a single window, or a region at full resolution.", video: "/videos/screen-and-window.mp4" },
  { label: "Camera & mic", body: "Add a webcam bubble and crisp audio. Anchor it anywhere, resize on the fly.", video: "/videos/camera-and-mic.mp4" },
  { label: "iPhone & devices", body: "Plug in your iPhone and record its screen instead of your Mac's, with the same polish.", video: "/videos/iphone.mp4" },
];
const editing = [
  { label: "Zoom & animation", body: "Auto-zoom follows your cursor, and custom animations are yours to add. Every move stays editable.", video: "/videos/zoom-and-animation.mp4" },
  { label: "Backdrops & framing", body: "Rounded corners, padding, and a soft shadow over a backdrop of your choice.", video: "/videos/backdrops-and-framing.mp4" },
  { label: "Timeline & export", body: "Trim, tweak, and export a share-ready video with presets for every platform." },
];
---

<Layout>
  <div id="page" class="pt-16">
    <Nav />
    <!-- Hero -->
    <section class="text-center pt-[var(--space-4xl)]">
      <Container>
        <img
          src="/dolly-logo-single.svg"
          alt="Dolly"
          class="mx-auto block h-8 w-8 [filter:invert(1)]"
        />
        <h1
          class="mx-auto mt-8 w-10/12 max-w-3xl text-3xl leading-[1.05] tracking-[-1px] text-text sm:w-auto sm:text-5xl"
        >
          Production-grade<br />screen demos.
        </h1>
        <p
          class="mx-auto mt-5 w-10/12 max-w-xl text-base text-text-muted sm:w-auto sm:text-lg"
        >
          Record, zoom, and polish screen recordings automatically.{" "}<br
            class="hidden sm:inline"
          />Natively and locally on your Mac.
        </p>

        <a
          href={DMG}
          class="press mt-8 inline-block rounded-pill bg-btn-primary px-6 py-3 text-base text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
        >
          Start 7-day trial
        </a>

        <!-- Hero-video -->
        <video
          class="aspect-video w-full rounded-xs bg-surface object-cover mt-[var(--space-2xl)] sm:mt-[var(--space-4xl)]"
          src="/videos/kinfolk-zoom.mp4"
          autoplay
          muted
          loop
          playsinline
        ></video>
      </Container>
    </section>

    <!-- USP-rad -->
    <Usps />

    <!-- Recording -->
    <MediaShowcase
      id="features"
      title="All in one take."
      body="Screen, camera, mic, system audio, even your iPhone. One take, zero setup."
      items={recording}
    />

    <!-- Editing -->
    <MediaShowcase
      title="Beautiful by default."
      body="Auto-zoom, backdrops, and smooth motion. Dolly does the polish, you keep control."
      items={editing}
    />

    <!-- Vem den är för -->
    <Audience />

    <!-- Detaljerade inställningar -->
    <FineTune />

    <!-- Pricing -->
    <Pricing />

    <!-- FAQ -->
    <FAQ />
  </div>

  <Footer />
</Layout>

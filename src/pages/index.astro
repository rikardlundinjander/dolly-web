---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// Fas 1 — komponentiserad stomme. Copy är placeholder men domän-relevant.
const features = [
  { title: "Auto-zoom", body: "Kameran följer pekaren automatiskt — mjukt och redigerbart." },
  { title: "Polished backdrops", body: "Rundade hörn, padding och skugga direkt ur lådan." },
  { title: "Smooth cursor", body: "Utjämnad pekarrörelse renderad ur inspelad metadata." },
];
---

<Layout>
  <!-- Vit innehållsyta ovanpå mörk footer (footer-reveal) -->
  <div class="relative z-10 rounded-b-[2rem] bg-bg pb-24">
    <Nav />

    <!-- Hero -->
    <Container class="flex flex-col items-center pt-24 text-center">
      <span
        class="mb-8 inline-flex items-center gap-2 rounded-pill bg-accent px-3 py-1 text-xs font-medium text-accent-contrast"
      >
        v1.0 — nu tillgänglig
      </span>

      <div class="mb-8 size-16 rounded-[18px] bg-text shadow-md"></div>

      <h1
        class="max-w-4xl font-display text-5xl font-bold leading-[1.02] tracking-[-0.03em] text-text sm:text-6xl"
      >
        Beautiful screen recordings, natively on Mac.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-text-muted">
        Dolly spelar in, zoomar och putsar automatiskt. Inget att konfigurera —
        exportera på sekunder.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#"
          class="rounded-pill bg-btn-primary px-6 py-3 text-sm font-medium text-btn-primary-text shadow-xs transition-colors duration-[var(--duration-fast)] ease-[var(--ease-out-quart)] hover:bg-btn-primary-hover"
        >
          Download for Mac
        </a>
        <a
          href="#"
          class="rounded-pill border border-border-strong bg-bg px-6 py-3 text-sm font-medium text-text shadow-xs transition-colors duration-[var(--duration-fast)] hover:bg-surface"
        >
          Watch the demo →
        </a>
      </div>
      <p class="mt-4 text-sm text-text-subtle">Kräver macOS 15 eller senare · Engångsköp</p>

      <!-- Mockup-container (video poppar här) -->
      <div
        class="mt-16 flex aspect-video w-full items-center justify-center rounded-xl bg-surface"
      >
        <span class="text-sm text-text-subtle">Produktvideo</span>
      </div>

      <!-- Feature-kort -->
      <div class="mt-20 grid w-full grid-cols-1 gap-4 text-left sm:grid-cols-3">
        {
          features.map((f) => (
            <div class="rounded-lg bg-surface p-6">
              <p class="text-base font-semibold text-text">{f.title}</p>
              <p class="mt-2 text-sm text-text-muted">{f.body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </div>

  <Footer />
</Layout>

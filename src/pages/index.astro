---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import KeyFeatures from "../components/KeyFeatures.astro";

// REDESIGN — Fas 1 scaffold. Hero-stub för att verifiera fundamentet
// (KH Teka, dark, typskala, grid). Riktiga sektioner byggs i Fas 2–4.
---

<Layout>
  <Nav />

  <main>
    <!-- Hero -->
    <section class="pt-24 pb-20 text-center md:pt-32">
      <Container>
        <img
          src="/dolly-logo-single.svg"
          alt="Dolly"
          class="mx-auto h-8 w-8 [filter:invert(1)]"
        />
        <h1
          data-reveal
          class="mx-auto mt-8 max-w-3xl text-4xl leading-[1.05] tracking-[-0.01em] text-text sm:text-5xl"
        >
          Production-grade screen demos.
        </h1>
        <p
          data-reveal
          class="mx-auto mt-5 max-w-xl text-base text-text-muted sm:text-lg"
        >
          Record, zoom, and polish screen recordings automatically. Natively and
          locally on your Mac.
        </p>

        <!-- Hero-video (placeholder) -->
        <div class="mt-14 aspect-video w-full rounded-lg bg-surface"></div>
      </Container>
    </section>

    <!-- Key features -->
    <KeyFeatures />
  </main>

  <Footer />
</Layout>

---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// Delad layout för policy-sidor. Markdown-sidor skickar in title/description
// via frontmatter; själva texten renderas i .legal-prosan.
const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? "Dolly";
const description = frontmatter?.description;
---

<Layout title={`${title} — Dolly`} description={description}>
  <div id="page" class="pt-16 pb-24">
    <Nav orb={false} />
    <main
      class="mx-auto w-full max-w-2xl px-[var(--gutter-page)] pt-16 pb-8 sm:pt-24"
    >
      <article class="legal">
        <slot />
      </article>
      <a
        href="/"
        class="mt-16 inline-block text-sm font-medium text-accent transition-colors hover:text-accent-hover"
      >
        ← Back to heydolly.app
      </a>
    </main>
  </div>
  <Footer />
</Layout>

<style is:global>
  .legal {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }
  .legal > :first-child {
    margin-top: 0;
  }
  /* Vikt och spärr sätts inte här — h1-h3 ärver sajtens rubrikstilar
     (vikt 400, --tracking-display) från global.css. Här bara storlek,
     färg och rytm. */
  .legal h1 {
    color: var(--text);
    font-size: 2.25rem;
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }
  .legal h2 {
    color: var(--text);
    font-size: 1.375rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .legal h3 {
    color: var(--text);
    font-size: 1.0625rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .legal p {
    margin-bottom: 1rem;
  }
  .legal ul,
  .legal ol {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .legal ul li {
    list-style: disc;
  }
  .legal ol li {
    list-style: decimal;
  }
  .legal a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal a:hover {
    color: var(--accent-hover);
  }
  /* Markdownens **fetmarkeringar** framhävs inte. Browserns default är
     bold, så vikten måste nollställas uttryckligen. */
  .legal strong {
    font-weight: 400;
  }
  .legal hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
  .legal code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-xs);
  }
</style>

---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Sätts på undersidor som inte ska indexeras. */
  noindex?: boolean;
}

// Söktermer i title/description (folk söker "screen recorder mac", inte
// "production-grade demos"). Hero-rubriken på sidan är oförändrad.
const {
  title = "Dolly — Screen recording for Mac, polished automatically",
  description = "Record your screen, camera, mic and iPhone in one take. Dolly adds cinematic zooms, backdrops and smooth motion automatically. A native Mac app, one-time purchase.",
  noindex = false,
} = Astro.props;

// Cloudflare Web Analytics: klistra in token från dashboarden (Web
// Analytics → din sajt → JS-snippet). Tomt värde = inget script laddas.
const CF_ANALYTICS_TOKEN = "3f16af3de1f44757b1f14b76f0698003";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;

// Strukturerad data: låter Google visa pris, plattform och kategori.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Dolly",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 15 (Sequoia) or later",
  url: "https://heydolly.app",
  description,
  offers: {
    "@type": "Offer",
    price: "69",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dolly" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    {
      CF_ANALYTICS_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>


<script>
  // Pausa autoplay-videor utanför vyn. Annars fortsätter hero- och
  // Polish-klippen dekoda genom hela sidan, vilket kostar frames under
  // scroll (märks tydligast i Safari). Showcase-spelarna sköter sig själva.
  const autoplayVideos =
    document.querySelectorAll<HTMLVideoElement>("video[autoplay]");
  if (autoplayVideos.length && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { rootMargin: "100px" },
    );
    autoplayVideos.forEach((v) => io.observe(v));
  }
</script>

<script>
  // Glare + tilt: följ pekaren över .glare/.tilt-ytor och uppdatera
  // CSS-vars (--glare-x/y, --tilt-x/y). Effekterna ligger i global.css.
  const MAX_TILT = 2; // grader åt varje håll
  const tiltReduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document
    .querySelectorAll<HTMLElement>(".glare, .tilt, .holo, .border-glare")
    .forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        if (
          el.classList.contains("glare") ||
          el.classList.contains("border-glare")
        ) {
          el.style.setProperty("--glare-x", x + "px");
          el.style.setProperty("--glare-y", y + "px");
        }
      if (el.classList.contains("holo")) {
        el.style.setProperty(
          "--holo-shift",
          ((x / r.width) * 100).toFixed(1) + "%",
        );
      }
      if (el.classList.contains("tilt") && !tiltReduce) {
        const nx = x / r.width - 0.5;
        const ny = y / r.height - 0.5;
        el.style.setProperty("--tilt-y", nx * 2 * MAX_TILT + "deg");
        el.style.setProperty("--tilt-x", -ny * 2 * MAX_TILT + "deg");
      }
    });
    el.addEventListener("pointerleave", () => {
      el.style.setProperty("--tilt-x", "0deg");
      el.style.setProperty("--tilt-y", "0deg");
    });
  });
</script>

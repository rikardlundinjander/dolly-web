---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dolly — Production-grade screen demos",
  description = "Record, zoom, and polish screen recordings automatically. Natively and locally on your Mac.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Scroll-reveal: fade + rise när [data-reveal] kommer i vy (en gång).
  const root = document.documentElement;
  root.setAttribute("data-anim", "");
  const els = document.querySelectorAll("[data-reveal]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) {
            e.target.setAttribute("data-visible", "");
            io.unobserve(e.target);
          }
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.setAttribute("data-visible", ""));
  }

  // Sektionsfokus: [data-focus] startar oskarp och skärps när sektionen
  // når viewportens mittband — en gång; därefter förblir den skarp.
  const focusEls = document.querySelectorAll("[data-focus]");
  if (!reduce && "IntersectionObserver" in window) {
    const focusIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) {
            e.target.setAttribute("data-infocus", "");
            focusIo.unobserve(e.target);
          }
      },
      { rootMargin: "-20% 0px -20% 0px", threshold: 0 },
    );
    focusEls.forEach((el) => focusIo.observe(el));
  } else {
    focusEls.forEach((el) => el.setAttribute("data-infocus", ""));
  }
</script>

<script>
  // Glare + tilt: följ pekaren över .glare/.tilt-ytor och uppdatera
  // CSS-vars (--glare-x/y, --tilt-x/y). Effekterna ligger i global.css.
  const MAX_TILT = 2; // grader åt varje håll
  const tiltReduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document
    .querySelectorAll<HTMLElement>(".glare, .tilt, .holo, .border-glare")
    .forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        if (
          el.classList.contains("glare") ||
          el.classList.contains("border-glare")
        ) {
          el.style.setProperty("--glare-x", x + "px");
          el.style.setProperty("--glare-y", y + "px");
        }
      if (el.classList.contains("holo")) {
        el.style.setProperty(
          "--holo-shift",
          ((x / r.width) * 100).toFixed(1) + "%",
        );
      }
      if (el.classList.contains("tilt") && !tiltReduce) {
        const nx = x / r.width - 0.5;
        const ny = y / r.height - 0.5;
        el.style.setProperty("--tilt-y", nx * 2 * MAX_TILT + "deg");
        el.style.setProperty("--tilt-x", -ny * 2 * MAX_TILT + "deg");
      }
    });
    el.addEventListener("pointerleave", () => {
      el.style.setProperty("--tilt-x", "0deg");
      el.style.setProperty("--tilt-y", "0deg");
    });
  });
</script>


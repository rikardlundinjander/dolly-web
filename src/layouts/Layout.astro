---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Sätts på undersidor som inte ska indexeras. */
  noindex?: boolean;
}

// Söktermer i title/description (folk söker "screen recorder mac", inte
// "production-grade demos"). Hero-rubriken på sidan är oförändrad.
const {
  title = "Dolly — Screen recording for Mac, polished automatically",
  description = "Record your screen, camera, mic and iPhone in one take. Dolly adds cinematic zooms, backdrops and smooth motion automatically. A native Mac app, one-time purchase.",
  noindex = false,
} = Astro.props;

// Cloudflare Web Analytics: klistra in token från dashboarden (Web
// Analytics → din sajt → JS-snippet). Tomt värde = inget script laddas.
const CF_ANALYTICS_TOKEN = "3f16af3de1f44757b1f14b76f0698003";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;

// Strukturerad data: låter Google visa pris, plattform och kategori.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Dolly",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 15 (Sequoia) or later",
  url: "https://heydolly.app",
  description,
  offers: {
    "@type": "Offer",
    price: "69",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Fallback för det som inte läser svg-favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#090909" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dolly" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    {
      CF_ANALYTICS_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>


<script>
  // Pausa autoplay-videor utanför vyn. Annars fortsätter hero- och
  // Polish-klippen dekoda genom hela sidan, vilket kostar frames under
  // scroll (märks tydligast i Safari). Showcase-spelarna sköter sig själva.
  const autoplayVideos =
    document.querySelectorAll<HTMLVideoElement>("video[autoplay]");
  if (autoplayVideos.length && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { rootMargin: "100px" },
    );
    autoplayVideos.forEach((v) => io.observe(v));
  }
</script>

<script>
  // Självläkande nedladdningslänk: [data-download] får sin href vid BYGGE,
  // så en app-release efter senaste sajtbygget skulle annars fortsätta peka
  // på en gammal DMG. Här hämtas appcasten i browsern och länkarna pekas om
  // vid behov. Byggets värde är fallback (fungerar utan JS).
  const links =
    document.querySelectorAll<HTMLAnchorElement>("a[data-download]");
  if (links.length) {
    fetch("https://updates.heydolly.app/appcast.xml", { cache: "no-store" })
      .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))
      .then((xml) => {
        // Para ihop varje <sparkle:version> med närmast följande
        // .dmg-enclosure och ta den högsta versionen (= senaste releasen).
        const re =
          /<sparkle:version>(\d+)<\/sparkle:version>[\s\S]*?<enclosure[^>]*?url="([^"]+?\.dmg)"/g;
        let best: { version: number; url: string } | null = null;
        for (const m of xml.matchAll(re)) {
          const version = parseInt(m[1], 10);
          if (!best || version > best.version) best = { version, url: m[2] };
        }
        if (best) {
          for (const a of links) {
            if (a.href !== best.url) a.href = best.url;
          }
        }
      })
      .catch(() => {
        /* offline eller feed nere → behåll byggets länk */
      });
  }
</script>

<script>
  // Glare + tilt: följ pekaren över .glare/.tilt-ytor och uppdatera
  // CSS-vars (--glare-x/y, --tilt-x/y). Effekterna ligger i global.css.
  const MAX_TILT = 2; // grader åt varje håll
  const MAX_PULL = 6; // px som ett magnetiskt element dras mot pekaren
  const tiltReduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document
    .querySelectorAll<HTMLElement>(
      ".glare, .tilt, .holo, .border-glare, .magnetic",
    )
    .forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        if (
          el.classList.contains("glare") ||
          el.classList.contains("border-glare")
        ) {
          el.style.setProperty("--glare-x", x + "px");
          el.style.setProperty("--glare-y", y + "px");
        }
      if (el.classList.contains("holo")) {
        el.style.setProperty(
          "--holo-shift",
          ((x / r.width) * 100).toFixed(1) + "%",
        );
      }
      if (el.classList.contains("magnetic") && !tiltReduce) {
        el.style.setProperty(
          "--mag-x",
          (x / r.width - 0.5) * 2 * MAX_PULL + "px",
        );
        el.style.setProperty(
          "--mag-y",
          (y / r.height - 0.5) * 2 * MAX_PULL + "px",
        );
      }
      if (el.classList.contains("tilt") && !tiltReduce) {
        const nx = x / r.width - 0.5;
        const ny = y / r.height - 0.5;
        el.style.setProperty("--tilt-y", nx * 2 * MAX_TILT + "deg");
        el.style.setProperty("--tilt-x", -ny * 2 * MAX_TILT + "deg");
      }
    });
    el.addEventListener("pointerleave", () => {
      el.style.setProperty("--tilt-x", "0deg");
      el.style.setProperty("--tilt-y", "0deg");
      el.style.setProperty("--mag-x", "0px");
      el.style.setProperty("--mag-y", "0px");
    });
  });
</script>

<script>
  // Sektioner glider in en gång när de kommer upp underifrån.
  // Ingen omvänd riktning och ingen upprepning: när en grupp väl landat
  // slutar vi observera den.
  const reveal = () => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const groups = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (!groups.length) return;

    const arm = (group: HTMLElement) => {
      // Indexet styr både startavståndet och fördröjningen, så delarna
      // ligger glest och dras ihop uppifrån och ned.
      group
        .querySelectorAll<HTMLElement>("[data-reveal-item]")
        .forEach((el, i) => el.style.setProperty("--reveal-i", String(i)));
      group.setAttribute("data-reveal-armed", "");
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          (e.target as HTMLElement).setAttribute("data-revealed", "");
          io.unobserve(e.target);
        }
      },
      // Lite in i vyn, annars startar rörelsen medan sektionen ännu är
      // en hårsmån utanför och man missar början av den.
      { rootMargin: "0px 0px -12% 0px" },
    );

    // Allt som redan passerats visas direkt, utan animering — annars kan
    // man scrolla uppåt in i en sektion som aldrig hunnit spela.
    const sweep = () => {
      for (const group of groups) {
        if (group.hasAttribute("data-revealed")) continue;
        if (group.getBoundingClientRect().top < innerHeight) {
          group.setAttribute("data-revealed", "");
          io.unobserve(group);
        } else {
          io.observe(group);
        }
      }
    };

    for (const group of groups) arm(group);
    sweep();
    // Laddas sidan om nedskrollad återställer browsern scrollpositionen
    // EFTER att det här körts. Sektioner som då hamnar ovanför vyn skulle
    // annars stå kvar dolda — observern fyrar aldrig för något som redan
    // passerat — och sidan såg tom ut tills man scrollade upp förbi dem.
    addEventListener("load", sweep);
    addEventListener("pageshow", sweep);
  };
  // Efter layout, så mätningen mot innerHeight sker på färdig sida.
  requestAnimationFrame(reveal);
</script>

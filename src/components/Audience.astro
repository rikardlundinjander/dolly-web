---
import Container from "./Container.astro";

// "Made for people who show their work." — självidentifiering före pricing.
// Fyra målgrupper, 3 kol vardera på 12-kol-gridden; mobil snap-scroll som
// Meet Dolly. Ingen media — texten bär, sidan har redan gott om rörelse.
const audiences = [
  {
    title: "Makers & founders",
    body: "Launch videos, changelogs and demos that carry a product on their own.",
  },
  {
    title: "Designers",
    body: "Show a flow, not a flat mockup. Walk through prototypes and hand off with context.",
  },
  {
    title: "Product teams",
    body: "Async updates, bug reports and reviews — a two-minute video instead of a meeting.",
  },
  {
    title: "Educators & creators",
    body: "Lessons, tutorials and course material that look produced without a production.",
  },
];
---

<section id="use-cases" class="pt-[var(--space-4xl)] md:pt-[var(--space-6xl)]">
  <Container>
    <div class="mx-auto w-10/12 text-center sm:w-auto">
      <h2
        class="text-xl text-text tracking-[-0.5px] sm:text-4xl sm:tracking-[-1px]"
      >
        Made for people who show their work.
      </h2>
    </div>

    <!-- Mobil: horisontell snap-scroll (bleder till skärmkant); md+: 12-kol grid -->
    <div
      class="mt-12 flex snap-x snap-mandatory gap-[var(--grid-gutter)] overflow-x-auto overflow-y-hidden -mx-[var(--gutter-page)] px-[var(--gutter-page)] scroll-px-[var(--gutter-page)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:mx-0 md:grid md:grid-cols-12 md:overflow-visible md:px-0 md:mt-[var(--space-3xl)]"
    >
      {
        audiences.map((a) => (
          <div class="w-10/12 shrink-0 snap-start md:col-span-3 md:w-auto">
            <h3 class="text-base text-text">{a.title}</h3>
            <p class="mt-2 text-sm text-text-muted pr-[var(--space-lg)]">
              {a.body}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>

---
import Container from "./Container.astro";

// Sektions-wrapper: konsekvent vertikal rytm + valfri centrerad intro.
interface Props {
  id?: string;
  kicker?: string;
  title?: string;
  lead?: string;
  class?: string;
}
const { id, kicker, title, lead, class: className = "" } = Astro.props;
---

<section id={id} class:list={["scroll-mt-24 py-20 sm:py-28", className]}>
  <Container>
    {
      (kicker || title || lead) && (
        <div data-reveal class="mx-auto mb-14 flex max-w-2xl flex-col items-center text-center">
          {kicker && (
            <span class="mb-3 text-sm font-medium text-accent">{kicker}</span>
          )}
          {title && (
            <h2 class="font-display text-4xl font-bold tracking-[-0.025em] text-text sm:text-5xl">
              {title}
            </h2>
          )}
          {lead && <p class="mt-4 text-lg text-text-muted">{lead}</p>}
        </div>
      )
    }
    <slot />
  </Container>
</section>

---
import Container from "./Container.astro";

// Sektions-wrapper: konsekvent vertikal rytm + valfri centrerad intro.
interface Props {
  id?: string;
  title?: string;
  lead?: string;
  class?: string;
}
const { id, title, lead, class: className = "" } = Astro.props;
---

<section id={id} class:list={["scroll-mt-24 py-20 sm:py-28", className]}>
  <Container>
    {
      (title || lead) && (
        <div data-reveal class="mx-auto mb-14 flex max-w-2xl flex-col items-center text-center">
          {title && (
            <h2 class="font-heading text-2xl font-normal tracking-[-0.75px] text-text sm:text-4xl">
              {title}
            </h2>
          )}
          {lead && <p class="mt-4 text-lg text-text-muted">{lead}</p>}
        </div>
      )
    }
    <slot />
  </Container>
</section>

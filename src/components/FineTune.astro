---
import Container from "./Container.astro";
import Icon from "./Icon.astro";

// "Fine-tune everything." — rationell verifiering före pricing: konkreta
// funktioner i ett 3-kolumnsrutnät (ikon + rubrik + kort text).
// Grund med 12 poster; plocka bort de som inte ska med.
// Ikoner: Google Material Symbols (se Icon.astro för hur man lägger till fler).
const features = [
  {
    icon: "wallpaper",
    title: "Backdrops",
    body: "Solid colors, gradients or your own image behind the frame.",
  },
  {
    icon: "padding",
    title: "Padding",
    body: "Breathing room around the recording, adjustable to the pixel.",
  },
  {
    icon: "fit_screen",
    title: "Inset",
    body: "Pull the frame inward without cropping any of the content inside it.",
  },
  {
    icon: "rounded_corner",
    title: "Rounded corners",
    body: "Match the radius to your brand, or square the corners off entirely.",
  },
  {
    icon: "layers",
    title: "Shadow",
    body: "Soft depth under the frame. Subtle by default, yours to dial in.",
  },
  {
    icon: "motion_blur",
    title: "Motion blur",
    body: "Fast pans and zooms stay smooth instead of stuttering between frames.",
  },
  {
    icon: "center_focus_strong",
    title: "Auto-zoom",
    body: "Follows your cursor and zooms where it matters. Every zoom stays editable.",
  },
  {
    icon: "mouse",
    title: "Cursor",
    body: "Resize it, smooth out its path, or hide the cursor from the take entirely.",
  },
  {
    icon: "aspect_ratio",
    title: "Aspect ratio",
    body: "Landscape, square or vertical, switched without re-recording.",
  },
  {
    icon: "crop",
    title: "Crop",
    body: "Cut the frame down to the part that matters, before or after recording.",
  },
  {
    icon: "chat_bubble",
    title: "Annotations",
    body: "Text, arrows and highlights, placed anywhere along the timeline.",
  },
  {
    icon: "movie",
    title: "Export presets",
    body: "Sized and encoded for wherever you're posting it, from Slack to YouTube.",
  },
] as const;

// TODO: sätt det faktiska antalet innan publicering.
const SETTING_COUNT = "40+";
---

<section class="pt-[var(--space-4xl)] md:pt-[var(--space-6xl)]">
  <Container>
    <div class="mx-auto w-10/12 text-center sm:w-auto sm:max-w-xl">
      <h2
        class="text-xl text-text tracking-[-0.5px] sm:text-4xl sm:tracking-[-1px]"
      >
        Fine-tune everything.
      </h2>
      <p class="mx-auto mt-4 text-base text-text-muted sm:text-lg">
        {SETTING_COUNT} settings behind every recording. Adjust the details that
        matter to you and leave the rest to Dolly.
      </p>
    </div>

    <!-- Statiska poster. Negativ marginal så ikon/rubrik linjerar med
         sektionsrubriken trots kortens vänsterpadding. -->
    <div
      class="mx-auto mt-12 grid w-10/12 grid-cols-1 gap-x-[var(--grid-gutter)] gap-y-1 md:-mx-6 md:mt-[var(--space-3xl)] md:w-auto md:grid-cols-12"
    >
      {
        features.map((f) => (
          <div class="rounded-md py-5 md:col-span-4 md:pl-6 md:pr-14">
            <div class="flex items-center gap-2.5">
              <Icon name={f.icon} class="size-6 text-text" />
              <h3 class="text-base text-text">{f.title}</h3>
            </div>
            <p class="mt-2 text-sm text-text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>

---
import Container from "./Container.astro";
import Icon from "./Icon.astro";

// "Fine-tune everything." — rationell verifiering före pricing: konkreta
// funktioner i ett 3-kolumnsrutnät (ikon + rubrik + kort text).
// Grund med 12 poster; plocka bort de som inte ska med.
// Ikoner: Google Material Symbols (se Icon.astro för hur man lägger till fler).
const features = [
  {
    icon: "colors",
    title: "Backgrounds",
    body: "Solid colors, gradients, your own image, or a fully transparent background.",
  },
  {
    icon: "picture_in_picture_center",
    title: "Padding",
    body: "Breathing room around the recording, set as a percentage of the frame.",
  },
  {
    icon: "activity_zone",
    title: "Mask",
    body: "Highlight what matters, or blur the parts that should stay private.",
  },
  {
    icon: "rounded_corner",
    title: "Rounded corners",
    body: "Match the radius to your brand, or square the corners off entirely.",
  },
  {
    icon: "layers",
    title: "Shadow",
    body: "Soft depth under the frame. Subtle by default, yours to dial in.",
  },
  {
    icon: "motion_blur",
    title: "Motion blur",
    body: "Fast pans and zooms stay smooth instead of stuttering between frames.",
  },
  {
    icon: "center_focus_strong",
    title: "Auto-zoom",
    body: "Follows your cursor and zooms where it matters. Every zoom stays editable.",
  },
  {
    icon: "arrow_selector_tool",
    title: "Cursor",
    body: "Resize it, smooth its path, swap it for a dot, or hide it from the take.",
  },
  {
    icon: "aspect_ratio",
    title: "Aspect ratio",
    body: "Landscape, square or vertical, switched without re-recording.",
  },
  {
    icon: "crop",
    title: "Crop",
    body: "Cut the frame down to the part that matters, before or after recording.",
  },
  {
    icon: "chat_bubble",
    title: "Annotations",
    body: "Pin text anywhere along the timeline, for the moments that need a label.",
  },
  {
    icon: "line_end_circle",
    title: "Intros and outros",
    body: "Open and close with an animation, from a preset or your own bezier curve.",
  },
] as const;

// TODO: sätt det faktiska antalet innan publicering.
const SETTING_COUNT = "40+";
---

<section data-reveal class="pt-flow-2xl">
  <Container>
    <div class="mx-auto w-10/12 text-center sm:w-auto sm:max-w-xl">
      <h2
        data-reveal-item
        class="text-xl text-text tracking-[-0.5px] sm:text-4xl sm:tracking-[-1px]"
      >
        Fine-tune everything.
      </h2>
      <p data-reveal-item class="mx-auto mt-4 text-base text-text-muted sm:text-lg">
        {SETTING_COUNT} settings behind every recording. Adjust the details that
        matter to you and leave the rest to Dolly.
      </p>
    </div>

    <!-- Hover-fyllning från md+ (där korten har padding att fylla).
         Negativ marginal så ikon/rubrik linjerar med sektionsrubriken. -->
    <div
      data-reveal-item
      class="mx-auto mt-flow-lg grid w-10/12 grid-cols-1 gap-x-[var(--grid-gutter)] gap-y-1 md:-mx-6 md:w-auto md:grid-cols-12"
    >
      {
        features.map((f) => (
          <div class="rounded-md md:rounded-xl py-5 transition-colors duration-[var(--duration-base)] md:col-span-4 md:pl-6 md:pr-14 md:hover:bg-surface">
            <div class="flex items-center gap-2.5">
              <Icon name={f.icon} class="size-6 text-text" />
              <h3 class="text-base text-text">{f.title}</h3>
            </div>
            <p class="mt-2 text-sm text-text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>

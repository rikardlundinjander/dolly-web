---
// Layoutprimitiv: centrerad max-bredd + sido-gutter. Använd överallt för
// konsekvent horisontell rytm.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "mx-auto w-full max-w-[var(--container-max)] px-[var(--spacing-gutter)]",
    className,
  ]}
>
  <slot />
</div>

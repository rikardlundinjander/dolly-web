---
// Layoutprimitiv: centrerad max-bredd (skissens 1328px) + responsiv sido-gutter.
// Övriga attribut släpps igenom till diven.
interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className = "", ...rest } = Astro.props;
---

<div
  {...rest}
  class:list={[
    "mx-auto w-full max-w-[var(--container-max)] px-[var(--gutter-page)] md:px-10",
    className,
  ]}
>
  <slot />
</div>

---
import Container from "./Container.astro";

// Mörk footer — avslöjas under den vita, rundade innehållsytan (footer-reveal).
const cols = [
  {
    heading: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "Pricing", href: "/#pricing" },
      { label: "FAQ", href: "/#faq" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
      { label: "Refund", href: "/refund" },
    ],
  },
];
---

<footer
  class="fixed inset-x-0 bottom-0 z-0 bg-inverse-bg pt-28 pb-10 text-inverse-text"
>
  <Container class="flex flex-col gap-12 sm:flex-row sm:justify-between">
    <div class="max-w-xs">
      <p class="font-display text-2xl font-bold tracking-tight">Dolly</p>
      <p class="mt-3 text-sm text-inverse-muted">
        Beautiful screen recordings for macOS.
      </p>
    </div>
    <div class="flex gap-16 text-sm">
      {
        cols.map((col) => (
          <ul class="flex flex-col gap-3 text-inverse-muted">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition-colors hover:text-inverse-text"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </Container>
  <Container class="mt-16 text-xs text-inverse-muted">© Dolly 2026</Container>
</footer>

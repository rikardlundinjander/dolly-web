---
import Container from "./Container.astro";

// Footer (redesign) — varumärkesblock + länkkolumner + ©-rad.
// Statisk, samma bakgrund som sidan, hårfin divider upptill.
const cols = [
  {
    heading: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "Pricing", href: "/#pricing" },
      { label: "FAQ", href: "/#faq" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
      { label: "Refund", href: "/refund" },
    ],
  },
];
---

<footer class="border-t border-border bg-bg pt-16 pb-10 text-text">
  <Container class="flex flex-col gap-12 sm:flex-row sm:justify-between">
    <div class="max-w-xs">
      <a href="/" class="inline-flex items-center" aria-label="Dolly">
        <img src="/dolly-logo.svg" alt="Dolly" class="h-5 w-auto" />
      </a>
    </div>
    <div class="flex gap-16 text-sm">
      {
        cols.map((col) => (
          <ul class="flex flex-col gap-3 text-text-muted">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-text">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </Container>
  <Container class="mt-16 text-xs text-text-subtle">
    <span>© Dolly 2026</span>
  </Container>
</footer>

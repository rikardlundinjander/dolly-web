---
import Container from "./Container.astro";

// Mörk minimal footer (redesign). Förfinas senare mot skissen.
const legal = [
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
  { label: "Refund", href: "/refund" },
];
---

<footer class="fixed inset-x-0 bottom-0 z-0 bg-surface py-16 text-text">
  <Container
    class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <a href="/" class="flex items-center gap-2.5" aria-label="Dolly">
      <img src="/dolly-logo-single.svg" alt="" class="h-5 w-5 [filter:invert(1)]" />
      <span class="text-lg tracking-tight text-text">Dolly</span>
    </a>
    <nav class="flex flex-wrap gap-x-8 gap-y-2 text-sm text-text-muted">
      {
        legal.map((l) => (
          <a href={l.href} class="transition-colors hover:text-text">
            {l.label}
          </a>
        ))
      }
    </nav>
    <p class="text-sm text-text-subtle">© Dolly 2026</p>
  </Container>
</footer>

---
import Container from "./Container.astro";

// Footer (redesign) — layout som v1: varumärkesblock + länkkolumner + ©-rad.
// Fixed bakom #page för footer-reveal. Dark-only, en vikt, tokens.
const cols = [
  {
    heading: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "Pricing", href: "/#pricing" },
      { label: "FAQ", href: "/#faq" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
      { label: "Refund", href: "/refund" },
    ],
  },
];
---

<footer
  class="fixed inset-x-0 bottom-0 z-0 bg-inverse-bg pt-28 pb-10 text-inverse-text"
>
  <Container class="flex flex-col gap-12 sm:flex-row sm:justify-between">
    <div class="max-w-xs">
      <a href="/" class="inline-flex items-center" aria-label="Dolly">
        <img
          src="/dolly-logo.svg"
          alt="Dolly"
          class="h-5 w-auto [filter:invert(1)]"
        />
      </a>
    </div>
    <div class="flex gap-16 text-sm">
      {
        cols.map((col) => (
          <ul class="flex flex-col gap-3 text-inverse-text-muted">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition-colors hover:text-inverse-text"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </Container>
  <Container class="mt-16 text-xs text-inverse-text-subtle">
    <span>© Dolly 2026</span>
  </Container>
</footer>

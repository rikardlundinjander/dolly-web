---
import Container from "./Container.astro";

// "Meet Dolly." — appen i tre enkla steg (Record → Polish → Share).
// 3-upp (media + titel + text) på 12-kol-gridden; mobil snap-scroll.
// Statisk sektion: inga hover-states. Steg med video autospelar i loop,
// övriga visar en tom yta i samma färg som klippens bakgrund.
const features = [
  {
    title: "Record",
    body: "Press record and talk. Setup isn't your problem.",
  },
  {
    title: "Polish",
    body: "It looks edited. You didn't edit it.",
    video: "/videos/polish.mp4",
  },
  {
    title: "Share",
    body: "Post-ready the moment you stop.",
  },
];
---

<section id="features">
  <Container>
    <p class="text-lg text-text sm:text-xl">Meet Dolly.</p>
    <!-- Mobil: horisontell snap-scroll (bleder till skärmkant); md+: 12-kol grid -->
    <div
      class="mt-8 flex snap-x snap-mandatory gap-[var(--grid-gutter)] overflow-x-auto overflow-y-hidden -mx-[var(--gutter-page)] px-[var(--gutter-page)] scroll-px-[var(--gutter-page)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:mx-0 md:grid md:grid-cols-12 md:overflow-visible md:px-0"
    >
      {
        features.map((f) => (
          <div class="w-10/12 shrink-0 snap-start md:col-span-4 md:w-auto">
            {f.video ? (
              <video
                class="aspect-video w-full rounded-xs bg-surface-media object-cover"
                src={f.video}
                autoplay
                muted
                loop
                playsinline
              />
            ) : (
              <div class="aspect-video w-full rounded-xs bg-surface-media" />
            )}
            <h3 class="mt-6 text-base text-text">{f.title}</h3>
            <p class="mt-2 text-sm text-text-muted pr-[var(--space-lg)]">
              {f.body}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>

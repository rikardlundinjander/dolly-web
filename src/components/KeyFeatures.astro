---
import Container from "./Container.astro";

// "Meet Dolly." — appen i tre enkla steg (Record → Polish → Share).
// 3-upp (bild + titel + text) på 12-kol-gridden; mobil snap-scroll.
const features = [
  {
    title: "Record",
    body: "Screen, camera, mic — even your iPhone. One take is all it takes.",
  },
  {
    title: "Polish",
    body: "Zooms, backdrops and motion, added as you go. Still yours to edit.",
  },
  {
    title: "Share",
    body: "Export with presets for every platform. Seconds, not sessions.",
  },
];
---

<section id="features" data-focus>
  <Container data-reveal>
    <p class="text-lg text-text sm:text-xl">Meet Dolly.</p>
    <!-- Mobil: horisontell snap-scroll (bleder till skärmkant); md+: 12-kol grid -->
    <div
      class="mt-8 flex snap-x snap-mandatory gap-[var(--grid-gutter)] overflow-x-auto overflow-y-hidden -mx-[var(--gutter-page)] px-[var(--gutter-page)] scroll-px-[var(--gutter-page)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:mx-0 md:grid md:grid-cols-12 md:overflow-visible md:px-0"
    >
      {
        features.map((f) => (
          <div class="group w-10/12 shrink-0 snap-start md:col-span-4 md:w-auto">
            <div class="aspect-video w-full rounded-xs bg-surface transition-colors duration-[var(--duration-slow)] group-hover:bg-surface-elevated" />
            <h3 class="mt-6 text-base text-text">{f.title}</h3>
            <p class="mt-2 text-sm text-text-muted pr-[var(--space-lg)]">
              {f.body}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>

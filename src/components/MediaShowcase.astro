---
import Container from "./Container.astro";

// Media-sektion (redesign): centrerad titel + paragraf → spelare → 3 väljar-USP.
// Endast aktiv item har vitt progress-streck; det speglar videons längd
// (5s-timer som fallback för placeholder-items utan klipp). När videon är
// slut nollas strecket och nästa item startar. Klick på spelaren (eller
// hover-ikonen i hörnet) togglar play/pause.
interface Item {
  label: string;
  body: string;
  video?: string; // mp4-URL; utelämnad = grå placeholder + timer
}
interface Props {
  title: string;
  body: string;
  items: Item[];
}
const { title, body, items } = Astro.props;
---

<section data-focus class="pt-[var(--space-4xl)] md:pt-[var(--space-6xl)]">
  <Container>
    <div data-reveal class="mx-auto max-w-xl text-center">
      <h2 class="text-3xl text-text sm:text-4xl">{title}</h2>
      <p class="mx-auto mt-4 max-w-sm text-lg text-text-muted">{body}</p>
    </div>

    <div data-showcase class="mt-14 md:mt-[var(--space-3xl)]">
      <!-- Spelare -->
      <div
        data-player
        data-reveal
        class="group relative flex aspect-video w-full cursor-pointer items-center justify-center overflow-hidden rounded-xs bg-surface"
      >
        <span data-player-label class="text-sm text-text-subtle"></span>
        <video
          data-video
          class="absolute inset-0 hidden h-full w-full object-cover"
          muted
          playsinline
          preload="metadata"></video>
        <!-- Play/pause vid hover -->
        <button
          type="button"
          data-toggle
          aria-label="Play or pause"
          class="absolute right-4 bottom-4 z-10 flex size-10 cursor-pointer items-center justify-center rounded-pill bg-bg/60 text-text opacity-0 backdrop-blur-md transition-opacity duration-[var(--duration-base)] group-hover:opacity-100"
        >
          <svg
            data-icon-play
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
            class="size-4"
          >
            <path d="M5 3.2v9.6L12.5 8 5 3.2z"></path>
          </svg>
          <svg
            data-icon-pause
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
            class="hidden size-4"
          >
            <path d="M4.5 3h2.4v10H4.5zM9.1 3h2.4v10H9.1z"></path>
          </svg>
        </button>
      </div>

      <!-- Väljare -->
      <div class="grid-12 mt-10">
        {
          items.map((it, i) => (
            <button
              type="button"
              data-item
              data-index={i}
              data-video-src={it.video ?? ""}
              data-reveal
              class="group cursor-pointer text-left md:col-span-4"
              style={`--reveal-delay: ${i * 90}ms`}
            >
              <span class="block h-px w-full overflow-hidden bg-border transition-colors duration-[var(--duration-base)] group-hover:bg-border-strong">
                <span data-progress class="block h-full w-0 bg-text" />
              </span>
              <span
                data-title
                class="mt-4 block text-base pr-[var(--space-lg)] transition-colors duration-[var(--duration-base)]"
              >
                {it.label}
              </span>
              <span class="mt-2 block text-sm text-text-muted pr-[var(--space-lg)]">
                {it.body}
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<script>
  const DURATION = 5000; // ms — fallback-"videolängd" för placeholder-items
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-showcase]").forEach((root) => {
    const player = root.querySelector<HTMLElement>("[data-player]");
    const video = root.querySelector<HTMLVideoElement>("[data-video]");
    const label = root.querySelector<HTMLElement>("[data-player-label]");
    const toggleBtn = root.querySelector<HTMLElement>("[data-toggle]");
    const iconPlay = root.querySelector<HTMLElement>("[data-icon-play]");
    const iconPause = root.querySelector<HTMLElement>("[data-icon-pause]");
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const titles = items.map(
      (i) => i.querySelector<HTMLElement>("[data-title]")!,
    );
    const bars = items.map(
      (i) => i.querySelector<HTMLElement>("[data-progress]")!,
    );
    if (!items.length || !player) return;

    const srcs = items.map((i) => i.dataset.videoSrc || "");
    let current = 0;
    let playing = false;
    let userPaused = false; // manuell paus ska överleva scroll ut/in
    let raf = 0;
    let startTs = 0;
    let elapsed = 0;

    const isVideo = () => !!srcs[current] && !!video;

    // Endast aktiv item har vitt streck; övriga visar bara spårets botten.
    const paint = (pct: number) => {
      bars.forEach(
        (b, idx) => (b.style.width = idx === current ? pct + "%" : "0%"),
      );
    };

    const updateIcons = () => {
      iconPlay?.classList.toggle("hidden", playing);
      iconPause?.classList.toggle("hidden", !playing);
    };

    const setActive = (i: number) => {
      current = i;
      startTs = 0;
      elapsed = 0;
      items.forEach((it, idx) => it.toggleAttribute("data-active", idx === i));
      titles.forEach(
        (t, idx) =>
          (t.style.color = idx === i ? "var(--text)" : "var(--text-muted)"),
      );
      paint(0);
      if (label) label.textContent = titles[i].textContent;
      if (video) {
        if (srcs[i]) {
          video.classList.remove("hidden");
          if (video.getAttribute("src") !== srcs[i])
            video.setAttribute("src", srcs[i]);
          video.currentTime = 0;
        } else {
          video.pause();
          video.classList.add("hidden");
          video.removeAttribute("src");
        }
      }
    };

    // Video slut → strecket nollas (via setActive) och nästa startar.
    const advance = () => {
      setActive((current + 1) % items.length);
      if (playing) startPlayback();
    };

    // rAF-driven målning i båda lägena — video.currentTime läses per frame
    // (timeupdate fyrar bara ~4 ggr/s och ger hack i linjen).
    const tick = (ts: number) => {
      if (!playing) return;
      if (isVideo()) {
        if (video!.duration)
          paint((video!.currentTime / video!.duration) * 100);
      } else {
        if (!startTs) startTs = ts - elapsed;
        elapsed = ts - startTs;
        const p = Math.min(elapsed / DURATION, 1);
        paint(p * 100);
        if (p >= 1) {
          advance();
          return;
        }
      }
      raf = requestAnimationFrame(tick);
    };

    const startPlayback = () => {
      cancelAnimationFrame(raf); // aldrig mer än en loop
      if (isVideo()) {
        video!.play().catch(() => {});
      } else {
        startTs = 0;
      }
      raf = requestAnimationFrame(tick);
    };

    const play = () => {
      if (playing) return;
      playing = true;
      updateIcons();
      startPlayback();
    };
    const pause = () => {
      if (!playing) return;
      playing = false;
      updateIcons();
      cancelAnimationFrame(raf);
      if (isVideo()) video!.pause();
    };
    const togglePlay = () => {
      if (playing) {
        userPaused = true;
        pause();
      } else {
        userPaused = false;
        play();
      }
    };

    video?.addEventListener("ended", advance);

    // Klick på hela spelaren togglar; ikonen likaså (utan dubbeltrigga).
    player.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-toggle]")) return;
      togglePlay();
    });
    toggleBtn?.addEventListener("click", togglePlay);

    items.forEach((it, i) =>
      it.addEventListener("click", () => {
        // Klick på redan aktiv item togglar play/paus istället för omstart.
        if (i === current) {
          togglePlay();
          return;
        }
        setActive(i);
        if (!reduce) {
          userPaused = false;
          play();
        }
      }),
    );

    setActive(0);
    updateIcons();

    if (reduce) return;
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            if (!userPaused) play();
          } else {
            pause();
          }
        },
        { threshold: 0.4 },
      );
      io.observe(root);
    } else {
      play();
    }
  });
</script>

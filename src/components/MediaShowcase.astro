---
import Container from "./Container.astro";
import Icon from "./Icon.astro";

// Media-sektion (redesign): centrerad titel + paragraf → spelare → 3 väljare.
// Väljarna är boxar på desktop; den aktiva har ljusare yta. När videon är
// slut startar nästa (items utan klipp byts på en 5s-timer). Klick på
// spelaren, eller på ikonen i mitten, togglar play/pause.
interface Item {
  label: string;
  body: string;
  icon: IconName;
  video?: string; // mp4-URL; utelämnad = grå placeholder + timer
  image?: string; // stillbild som placeholder (timer-driven progress)
}
interface Props {
  title: string;
  body: string;
  items: Item[];
  id?: string;
}
const { title, body, items, id } = Astro.props;
type IconName = Parameters<typeof Icon>[0]["name"];
---

<section id={id} data-reveal class="pt-flow-2xl">
  <Container>
    <div class="mx-auto w-10/12 max-w-xl text-center sm:w-auto">
      <h2 data-reveal-item class="text-xl text-text sm:text-4xl">{title}</h2>
      <p
        data-reveal-item
        class="mx-auto mt-4 max-w-sm text-base text-text-muted sm:text-lg"
      >
        {body}
      </p>
    </div>

    <div data-showcase data-reveal-item class="mt-flow-lg">
      <!-- Spelare: två videolager som korsfadar, så bytet aldrig blinkar
           till en tom ruta och övergången blir mjuk. -->
      <div
        data-player
        class="group relative hidden aspect-video w-full cursor-pointer items-center justify-center overflow-hidden rounded-md md:rounded-xl bg-surface-media md:flex"
      >
        <span data-player-label class="text-sm text-text-subtle"></span>
        <img
          data-image
          class="absolute inset-0 hidden h-full w-full object-cover"
          alt=""
        />
        <video
          data-video
          data-layer="0"
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-[var(--duration-slow)]"
          muted
          playsinline
          preload="auto"></video>
        <video
          data-video
          data-layer="1"
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-[var(--duration-slow)]"
          muted
          playsinline
          preload="auto"></video>
        <!-- Play/pause centrerat i ramen -->
        <button
          type="button"
          data-toggle
          aria-label="Play or pause"
          class="absolute top-1/2 left-1/2 z-10 flex size-14 -translate-x-1/2 -translate-y-1/2 cursor-pointer items-center justify-center rounded-pill bg-bg/60 text-text backdrop-blur-md transition-opacity duration-[var(--duration-base)] data-[playing]:opacity-0 data-[playing]:group-hover:opacity-100"
        >
          <svg
            data-icon-play
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
            class="size-5"
          >
            <path d="M5 3.2v9.6L12.5 8 5 3.2z"></path>
          </svg>
          <svg
            data-icon-pause
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
            class="hidden size-5"
          >
            <path d="M4.5 3h2.4v10H4.5zM9.1 3h2.4v10H9.1z"></path>
          </svg>
        </button>
      </div>

      <!-- Mobil: staplade block med egen spelare. Desktop: väljare i 12-kol grid. -->
      <div
        data-items
        class="flex flex-col gap-12 md:mt-10 md:grid md:grid-cols-12 md:gap-[var(--grid-gutter)]"
      >
        {
          items.map((it, i) => (
            <div
              data-item-wrap
              class="flex flex-col md:col-span-4 md:contents"
            >
              {/* Mobil: egen videoruta per block */}
              <div
                data-mobile-player
                data-src={it.video ?? ""}
                class="group relative mb-5 flex aspect-video w-full items-center justify-center overflow-hidden rounded-md md:rounded-xl bg-surface-media md:hidden"
              >
                {it.video && (
                  <video
                    data-mobile-video
                    class="absolute inset-0 h-full w-full object-cover"
                    muted
                    playsinline
                    preload="none"
                  />
                )}
                {it.video && (
                  <button
                    type="button"
                    data-mobile-toggle
                    aria-label={`Play ${it.label}`}
                    class="absolute top-1/2 left-1/2 z-10 flex size-14 -translate-x-1/2 -translate-y-1/2 cursor-pointer items-center justify-center rounded-pill bg-bg/60 text-text backdrop-blur-md transition-opacity duration-[var(--duration-base)] data-[playing]:opacity-0"
                  >
                    <svg
                      data-m-play
                      viewBox="0 0 16 16"
                      fill="currentColor"
                      aria-hidden="true"
                      class="size-5"
                    >
                      <path d="M5 3.2v9.6L12.5 8 5 3.2z" />
                    </svg>
                    <svg
                      data-m-pause
                      viewBox="0 0 16 16"
                      fill="currentColor"
                      aria-hidden="true"
                      class="hidden size-5"
                    >
                      <path d="M4.5 3h2.4v10H4.5zM9.1 3h2.4v10H9.1z" />
                    </svg>
                  </button>
                )}
              </div>

              {/* Desktop: en box per val — transparent, mörkgrå vid hover,
                  ett steg ljusare när den är aktiv. Mobil: ingen box, bara
                  ikon + text under sin egen videoruta. */}
              <button
                type="button"
                data-item
                data-index={i}
                data-video-src={it.video ?? ""}
                data-image-src={it.image ?? ""}
                class="group cursor-default text-left md:col-span-4 md:flex md:cursor-pointer md:flex-col md:rounded-xl md:p-5 md:transition-colors md:duration-[var(--duration-base)] md:hover:bg-surface md:data-[active]:bg-surface-elevated"
              >
                {/* Färgen sitter på raden, inte på texten, så ikonen ärver
                    den. Nedtoningen gäller bara md+: på mobil har varje block
                    sin egen spelare och det finns inget aktivt val. */}
                <span class="flex items-center gap-2 transition-colors duration-[var(--duration-base)] md:text-text-muted md:group-hover:text-text md:group-data-[active]:text-text">
                  <Icon name={it.icon} class="size-5 shrink-0" />
                  <span data-title class="block text-base">{it.label}</span>
                </span>
                <span
                  data-body
                  class="mt-2 block text-sm text-text-muted pr-[var(--space-lg)] transition-colors duration-[var(--duration-base)] md:pr-0 md:text-text-subtle md:group-data-[active]:text-text-muted"
                >
                  {it.body}
                </span>
              </button>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<script>
  const DURATION = 5000; // ms — fallback-"videolängd" för placeholder-items
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Mobil: varje block har en egen spelare. Klippet hämtas först när
  // blocket närmar sig vyn (preload="none" + IntersectionObserver), och
  // spelas bara på användarens initiativ.
  const mobilePlayers = document.querySelectorAll<HTMLElement>(
    "[data-mobile-player]",
  );
  if (mobilePlayers.length) {
    const arm = (wrap: HTMLElement) => {
      const v = wrap.querySelector<HTMLVideoElement>("[data-mobile-video]");
      const src = wrap.dataset.src;
      if (!v || !src) return;
      if (!v.getAttribute("src")) {
        v.setAttribute("src", src);
        v.load();
      }
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const wrap = e.target as HTMLElement;
            const v = wrap.querySelector<HTMLVideoElement>(
              "[data-mobile-video]",
            );
            if (e.isIntersecting) arm(wrap);
            else v?.pause();
          }
        },
        { rootMargin: "200px" },
      );
      mobilePlayers.forEach((w) => io.observe(w));
    } else {
      mobilePlayers.forEach(arm);
    }

    mobilePlayers.forEach((wrap) => {
      const v = wrap.querySelector<HTMLVideoElement>("[data-mobile-video]");
      const btn = wrap.querySelector<HTMLElement>("[data-mobile-toggle]");
      if (!v || !btn) return;
      const play = wrap.querySelector<HTMLElement>("[data-m-play]");
      const pause = wrap.querySelector<HTMLElement>("[data-m-pause]");
      const sync = () => {
        play?.classList.toggle("hidden", !v.paused);
        pause?.classList.toggle("hidden", v.paused);
        btn.toggleAttribute("data-playing", !v.paused);
      };
      const toggle = () => {
        const firstTouch = !v.getAttribute("src");
        arm(wrap);
        if (!v.paused) {
          v.pause();
          return;
        }
        // Direkt försök behåller kopplingen till användargesten (iOS),
        // canplay fångar upp om klippet inte hunnit ladda vid första klicket.
        const tryPlay = () => v.play().catch(() => {});
        tryPlay();
        if (firstTouch || v.readyState < 2)
          v.addEventListener("canplay", tryPlay, { once: true });
      };
      wrap.addEventListener("click", toggle);
      v.addEventListener("play", sync);
      v.addEventListener("pause", sync);
      v.addEventListener("ended", () => {
        v.currentTime = 0;
        sync();
      });
      sync();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-showcase]").forEach((root) => {
    const player = root.querySelector<HTMLElement>("[data-player]");
    const layers = [
      ...root.querySelectorAll<HTMLVideoElement>("[data-video]"),
    ];
    let front = 0; // vilket lager som visas just nu
    const video = () => layers[front];
    const image = root.querySelector<HTMLImageElement>("[data-image]");
    const label = root.querySelector<HTMLElement>("[data-player-label]");
    const mdQuery = matchMedia("(min-width: 768px)");
    const toggleBtn = root.querySelector<HTMLElement>("[data-toggle]");
    const iconPlay = root.querySelector<HTMLElement>("[data-icon-play]");
    const iconPause = root.querySelector<HTMLElement>("[data-icon-pause]");
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const titles = items.map(
      (i) => i.querySelector<HTMLElement>("[data-title]")!,
    );
    if (!items.length || !player) return;

    const srcs = items.map((i) => i.dataset.videoSrc || "");
    const imgSrcs = items.map((i) => i.dataset.imageSrc || "");

    let current = 0;
    let playing = false;
    let userPaused = false; // manuell paus ska överleva scroll ut/in
    let raf = 0;
    let startTs = 0;
    let elapsed = 0;

    const isVideo = () => !!srcs[current] && layers.length > 0;

    const updateIcons = () => {
      iconPlay?.classList.toggle("hidden", playing);
      iconPause?.classList.toggle("hidden", !playing);
      // Knappen ligger kvar synlig i pausat läge; under uppspelning tonas
      // den bort och kommer fram vid hover.
      toggleBtn?.toggleAttribute("data-playing", playing);
    };

    const setActive = (i: number) => {
      current = i;
      startTs = 0;
      elapsed = 0;
      // Aktivt läge är ett attribut; färgerna sköts av css, som också
      // begränsar nedtoningen till md+.
      items.forEach((it, idx) => it.toggleAttribute("data-active", idx === i));
      // Label bara när varken video eller bild finns för aktivt item.
      if (label)
        label.textContent =
          srcs[i] || imgSrcs[i] ? "" : titles[i].textContent;
      if (layers.length) {
        if (srcs[i]) {
          const cur = layers[front];
          // Redan rätt klipp i framlagret: spola bara tillbaka.
          if (cur.getAttribute("src") === srcs[i]) {
            if (cur.readyState > 0) cur.currentTime = 0;
            cur.style.opacity = "1";
          } else {
            // Ladda i baklagret och korsfada när det har bildinnehåll.
            // iOS laddar inte video utan användargest, så loadeddata kan
            // dröja eller utebli: visa lagret ändå efter en kort stund,
            // annars blir rutan stående tom.
            const next = layers[(front + 1) % layers.length];
            const nothingShownYet = !cur.getAttribute("src");
            let revealed = false;
            const reveal = () => {
              if (revealed) return;
              revealed = true;
              next.style.opacity = "1";
              cur.style.opacity = "0";
              front = (front + 1) % layers.length;
              window.setTimeout(() => {
                if (layers[front] !== cur) cur.pause();
              }, 400);
              if (playing) next.play().catch(() => {});
            };
            next.removeAttribute("src");
            next.setAttribute("src", srcs[i]);
            next.load(); // iOS börjar annars inte hämta alls
            // Första klippet har inget att korsfada från: visa direkt.
            if (nothingShownYet || next.readyState >= 2) reveal();
            else {
              next.addEventListener("loadeddata", reveal, { once: true });
              window.setTimeout(reveal, 700);
            }
          }
        } else {
          layers.forEach((v) => {
            v.pause();
            v.style.opacity = "0";
          });
        }
      }
      if (image) {
        if (!srcs[i] && imgSrcs[i]) {
          if (image.getAttribute("src") !== imgSrcs[i])
            image.setAttribute("src", imgSrcs[i]);
          image.classList.remove("hidden");
        } else {
          image.classList.add("hidden");
        }
      }
    };

    // Video slut → strecket nollas (via setActive) och nästa startar.
    const advance = () => {
      setActive((current + 1) % items.length);
      if (playing) startPlayback();
    };

    // Loopen behövs bara för items utan klipp — de byts på en timer.
    // Riktiga videor avancerar på 'ended'.
    const tick = (ts: number) => {
      if (!playing || isVideo()) return;
      if (!startTs) startTs = ts - elapsed;
      elapsed = ts - startTs;
      if (elapsed >= DURATION) {
        advance();
        return;
      }
      raf = requestAnimationFrame(tick);
    };

    const startPlayback = () => {
      cancelAnimationFrame(raf); // aldrig mer än en loop
      if (isVideo()) {
        const v = video();
        v.style.opacity = "1"; // säkerhetsnät om laddningen dröjt
        if (v.readyState === 0) v.load();
        v.play().catch(() => {});
      } else {
        startTs = 0;
        raf = requestAnimationFrame(tick);
      }
    };

    const play = () => {
      if (playing) return;
      playing = true;
      updateIcons();
      startPlayback();
    };
    const pause = () => {
      if (!playing) return;
      playing = false;
      updateIcons();
      cancelAnimationFrame(raf);
      if (isVideo()) video().pause();
    };
    const togglePlay = () => {
      if (playing) {
        userPaused = true;
        pause();
      } else {
        userPaused = false;
        play();
      }
    };

    layers.forEach((v) => {
      v.addEventListener("ended", () => {
        if (v === video()) advance();
      });
      // Snabba byten kan avbryta play(); återuppta när klippet är redo.
      v.addEventListener("canplay", () => {
        if (playing && v === video() && v.paused) v.play().catch(() => {});
      });
    });

    // Klick på hela spelaren togglar; ikonen likaså (utan dubbeltrigga).
    player.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-toggle]")) return;
      togglePlay();
    });
    toggleBtn?.addEventListener("click", togglePlay);

    items.forEach((it, i) =>
      it.addEventListener("click", () => {
        // Klick på redan aktiv item togglar play/paus istället för omstart.
        if (i === current) {
          togglePlay();
          return;
        }
        if (!mdQuery.matches) return; // på mobil har varje block egen spelare
        setActive(i);
        if (!reduce && playing) userPaused = false;
      }),
    );


    setActive(0);
    updateIcons();


    if (reduce) return;
    // Ingen autostart: uppspelningen börjar när besökaren trycker play.
    // Observern pausar när sektionen lämnar vyn och återupptar bara om
    // uppspelningen redan var igång.
    if ("IntersectionObserver" in window) {
      let wasPlaying = false;
      const io = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            if (wasPlaying && !userPaused) play();
          } else {
            wasPlaying = playing;
            pause();
          }
        },
        { threshold: 0.4 },
      );
      io.observe(root);
    }
  });
</script>

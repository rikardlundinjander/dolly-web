---
import Container from "./Container.astro";

// Media-sektion (redesign): centrerad titel + paragraf → spelare → 3 väljar-USP.
// Endast aktiv item har vitt progress-streck; det speglar videons längd
// (5s-timer som fallback för placeholder-items utan klipp). När videon är
// slut nollas strecket och nästa item startar. Klick på spelaren (eller
// hover-ikonen i hörnet) togglar play/pause.
interface Item {
  label: string;
  body: string;
  video?: string; // mp4-URL; utelämnad = grå placeholder + timer
  image?: string; // stillbild som placeholder (timer-driven progress)
}
interface Props {
  title: string;
  body: string;
  items: Item[];
}
const { title, body, items } = Astro.props;
---

<section data-focus class="pt-[var(--space-4xl)] md:pt-[var(--space-6xl)]">
  <Container data-reveal>
    <div class="mx-auto w-10/12 max-w-xl text-center sm:w-auto">
      <h2 class="text-xl text-text sm:text-4xl">{title}</h2>
      <p class="mx-auto mt-4 max-w-sm text-base text-text-muted sm:text-lg">
        {body}
      </p>
    </div>

    <div data-showcase class="mt-14 md:mt-[var(--space-3xl)]">
      <!-- Spelare -->
      <div
        data-player
        class="group relative flex aspect-video w-full cursor-pointer items-center justify-center overflow-hidden rounded-xs bg-surface"
      >
        <span data-player-label class="text-sm text-text-subtle"></span>
        <img
          data-image
          class="absolute inset-0 hidden h-full w-full object-cover"
          alt=""
        />
        <video
          data-video
          class="absolute inset-0 hidden h-full w-full object-cover"
          muted
          playsinline
          preload="metadata"></video>
        <!-- Play/pause vid hover -->
        <button
          type="button"
          data-toggle
          aria-label="Play or pause"
          class="absolute right-4 bottom-4 z-10 flex size-10 cursor-pointer items-center justify-center rounded-pill bg-bg/60 text-text opacity-0 backdrop-blur-md transition-opacity duration-[var(--duration-base)] group-hover:opacity-100"
        >
          <svg
            data-icon-play
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
            class="size-4"
          >
            <path d="M5 3.2v9.6L12.5 8 5 3.2z"></path>
          </svg>
          <svg
            data-icon-pause
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
            class="hidden size-4"
          >
            <path d="M4.5 3h2.4v10H4.5zM9.1 3h2.4v10H9.1z"></path>
          </svg>
        </button>
      </div>

      <!-- Mobil: en enda kvarliggande progress-linje under spelaren -->
      <div class="mt-6 block h-px w-full overflow-hidden bg-border md:hidden">
        <span data-mobile-progress class="block h-full w-0 bg-text"></span>
      </div>

      <!-- Väljare — mobil: swipebar snap-karusell (som Meet Dolly); md+: 12-kol grid -->
      <div
        data-items
        class="mt-8 flex snap-x snap-mandatory gap-[var(--grid-gutter)] overflow-x-auto overflow-y-hidden -mx-[var(--gutter-page)] px-[var(--gutter-page)] scroll-px-[var(--gutter-page)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:mx-0 md:mt-10 md:grid md:grid-cols-12 md:overflow-visible md:px-0"
      >
        {
          items.map((it, i) => (
            <button
              type="button"
              data-item
              data-index={i}
              data-video-src={it.video ?? ""}
              data-image-src={it.image ?? ""}
              class="group w-10/12 shrink-0 cursor-pointer snap-start text-left md:col-span-4 md:w-auto"
            >
              <span class="hidden h-px w-full overflow-hidden bg-border transition-colors duration-[var(--duration-base)] group-hover:bg-border-strong md:block">
                <span data-progress class="block h-full w-0 bg-text" />
              </span>
              <span
                data-title
                class="block text-base pr-[var(--space-lg)] transition-colors duration-[var(--duration-base)] md:mt-4"
              >
                {it.label}
              </span>
              <span
                data-body
                class="mt-2 block text-sm text-text-muted pr-[var(--space-lg)] transition-colors duration-[var(--duration-base)]"
              >
                {it.body}
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<script>
  const DURATION = 5000; // ms — fallback-"videolängd" för placeholder-items
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-showcase]").forEach((root) => {
    const player = root.querySelector<HTMLElement>("[data-player]");
    const video = root.querySelector<HTMLVideoElement>("[data-video]");
    const image = root.querySelector<HTMLImageElement>("[data-image]");
    const label = root.querySelector<HTMLElement>("[data-player-label]");
    const scroller = root.querySelector<HTMLElement>("[data-items]");
    const mobileBar = root.querySelector<HTMLElement>("[data-mobile-progress]");
    const mdQuery = matchMedia("(min-width: 768px)");
    const toggleBtn = root.querySelector<HTMLElement>("[data-toggle]");
    const iconPlay = root.querySelector<HTMLElement>("[data-icon-play]");
    const iconPause = root.querySelector<HTMLElement>("[data-icon-pause]");
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const titles = items.map(
      (i) => i.querySelector<HTMLElement>("[data-title]")!,
    );
    const bars = items.map(
      (i) => i.querySelector<HTMLElement>("[data-progress]")!,
    );
    const bodies = items.map(
      (i) => i.querySelector<HTMLElement>("[data-body]")!,
    );
    if (!items.length || !player) return;

    const srcs = items.map((i) => i.dataset.videoSrc || "");
    const imgSrcs = items.map((i) => i.dataset.imageSrc || "");

    // Infinite mobil-karusell: klona item-setet före + efter (md:hidden).
    // Strippen blir [kloner][riktiga][kloner]; när snappen landar i ett
    // klon-set teleporteras scrollLeft osynligt till mittsetet.
    const n = items.length;
    const cloneEls: HTMLElement[] = [];
    if (scroller && n > 1) {
      const makeClone = (it: HTMLElement) => {
        const c = it.cloneNode(true) as HTMLElement;
        c.removeAttribute("data-item");
        c.removeAttribute("data-reveal"); // kloner ska aldrig vara reveal-dolda
        c.setAttribute("data-clone", it.dataset.index || "0");
        c.classList.add("md:hidden");
        cloneEls.push(c);
        return c;
      };
      items.forEach((it) => scroller.appendChild(makeClone(it)));
      [...items]
        .reverse()
        .forEach((it) => scroller.insertBefore(makeClone(it), scroller.firstChild));
    }
    let current = 0;
    let playing = false;
    let userPaused = false; // manuell paus ska överleva scroll ut/in
    let raf = 0;
    let startTs = 0;
    let elapsed = 0;

    const isVideo = () => !!srcs[current] && !!video;

    // Endast aktiv item har vitt streck; övriga visar bara spårets botten.
    // Mobil: den enda kvarliggande linjen under spelaren speglar aktiv video.
    const paint = (pct: number) => {
      bars.forEach(
        (b, idx) => (b.style.width = idx === current ? pct + "%" : "0%"),
      );
      if (mobileBar) mobileBar.style.width = pct + "%";
    };

    // Mobil-karusell: snap-steg = kortbredd + gap (scroll-padding = sidmarginal).
    const scrollStep = () => {
      if (!scroller || !items[0]) return 0;
      const gap = parseFloat(getComputedStyle(scroller).columnGap) || 0;
      return items[0].offsetWidth + gap;
    };
    let suppressScrollUntil = 0;
    let scrollDriven = false; // val som kommer FRÅN swipen ska inte auto-scrolla
    const scrollToItem = (i: number) => {
      if (!scroller || mdQuery.matches || scrollDriven) return;
      const step = scrollStep();
      if (!step) return;
      // Välj närmaste kandidat i strippen (klon eller riktig) så rörelsen
      // alltid går kortaste vägen — sista → första fortsätter framåt.
      const sNow = Math.round(scroller.scrollLeft / step);
      let target = i + n;
      for (const cand of [i, i + n, i + 2 * n]) {
        if (Math.abs(cand - sNow) < Math.abs(target - sNow)) target = cand;
      }
      const left = target * step;
      if (Math.abs(scroller.scrollLeft - left) < 2) return;
      suppressScrollUntil = Date.now() + 700;
      scroller.scrollTo({ left, behavior: "smooth" });
    };

    const updateIcons = () => {
      iconPlay?.classList.toggle("hidden", playing);
      iconPause?.classList.toggle("hidden", !playing);
    };

    const setActive = (i: number) => {
      current = i;
      startTs = 0;
      elapsed = 0;
      items.forEach((it, idx) => it.toggleAttribute("data-active", idx === i));
      titles.forEach(
        (t, idx) =>
          (t.style.color = idx === i ? "var(--text)" : "var(--text-muted)"),
      );
      // Inaktiva brödtexter tonas ner ett steg extra
      bodies.forEach(
        (b, idx) =>
          (b.style.color =
            idx === i ? "var(--text-muted)" : "var(--text-subtle)"),
      );
      // Spegla aktiv-färgerna i klonerna (infinite-karusellen)
      cloneEls.forEach((c) => {
        const on = Number(c.dataset.clone) === i;
        const t = c.querySelector<HTMLElement>("[data-title]");
        const b = c.querySelector<HTMLElement>("[data-body]");
        if (t) t.style.color = on ? "var(--text)" : "var(--text-muted)";
        if (b) b.style.color = on ? "var(--text-muted)" : "var(--text-subtle)";
      });
      paint(0);
      // Label bara när varken video eller bild finns för aktivt item.
      if (label)
        label.textContent =
          srcs[i] || imgSrcs[i] ? "" : titles[i].textContent;
      if (video) {
        if (srcs[i]) {
          video.classList.remove("hidden");
          if (video.getAttribute("src") !== srcs[i]) {
            video.setAttribute("src", srcs[i]); // ny src laddar från 0
          } else if (video.readyState > 0) {
            video.currentTime = 0;
          }
        } else {
          video.pause();
          video.classList.add("hidden");
          video.removeAttribute("src");
        }
      }
      if (image) {
        if (!srcs[i] && imgSrcs[i]) {
          if (image.getAttribute("src") !== imgSrcs[i])
            image.setAttribute("src", imgSrcs[i]);
          image.classList.remove("hidden");
        } else {
          image.classList.add("hidden");
        }
      }
      scrollToItem(i);
    };

    // Video slut → strecket nollas (via setActive) och nästa startar.
    const advance = () => {
      setActive((current + 1) % items.length);
      if (playing) startPlayback();
    };

    // rAF-driven målning i båda lägena — video.currentTime läses per frame
    // (timeupdate fyrar bara ~4 ggr/s och ger hack i linjen).
    const tick = (ts: number) => {
      if (!playing) return;
      if (isVideo()) {
        if (video!.duration)
          paint((video!.currentTime / video!.duration) * 100);
      } else {
        if (!startTs) startTs = ts - elapsed;
        elapsed = ts - startTs;
        const p = Math.min(elapsed / DURATION, 1);
        paint(p * 100);
        if (p >= 1) {
          advance();
          return;
        }
      }
      raf = requestAnimationFrame(tick);
    };

    const startPlayback = () => {
      cancelAnimationFrame(raf); // aldrig mer än en loop
      if (isVideo()) {
        video!.play().catch(() => {});
      } else {
        startTs = 0;
      }
      raf = requestAnimationFrame(tick);
    };

    const play = () => {
      if (playing) return;
      playing = true;
      updateIcons();
      startPlayback();
    };
    const pause = () => {
      if (!playing) return;
      playing = false;
      updateIcons();
      cancelAnimationFrame(raf);
      if (isVideo()) video!.pause();
    };
    const togglePlay = () => {
      if (playing) {
        userPaused = true;
        pause();
      } else {
        userPaused = false;
        play();
      }
    };

    video?.addEventListener("ended", advance);
    // Snabb bläddring avbryter play()-anrop mitt i src-byten (grå ruta trots
    // "spelande" läge) — återuppta så fort nya klippet kan spela.
    video?.addEventListener("canplay", () => {
      if (playing && isVideo() && video.paused) video.play().catch(() => {});
    });

    // Klick på hela spelaren togglar; ikonen likaså (utan dubbeltrigga).
    player.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-toggle]")) return;
      togglePlay();
    });
    toggleBtn?.addEventListener("click", togglePlay);

    items.forEach((it, i) =>
      it.addEventListener("click", () => {
        // Klick på redan aktiv item togglar play/paus istället för omstart.
        if (i === current) {
          togglePlay();
          return;
        }
        setActive(i);
        if (!reduce) {
          userPaused = false;
          play();
        }
      }),
    );

    // Mobil: swipe väljer item DIREKT när närmsta snap-mål byts (halvvägs/
    // vid släpp) — inte efter landning; annars känns det laggigt.
    // Normaliseringen (teleport från klon-set till mittsetet) väntar dock
    // tills snappen landat (debounce).
    if (scroller) {
      let scrollDebounce = 0;
      scroller.addEventListener(
        "scroll",
        () => {
          if (mdQuery.matches) return;
          const step = scrollStep();
          if (!step) return;
          const s = Math.round(scroller.scrollLeft / step);
          const idx = ((s % n) + n) % n;
          if (Date.now() >= suppressScrollUntil && idx !== current) {
            scrollDriven = true;
            setActive(idx);
            scrollDriven = false;
            if (!reduce) {
              userPaused = false;
              play();
            }
          }
          clearTimeout(scrollDebounce);
          const settle = () => {
            // Teleportera först när snappen faktiskt landat — annars syns
            // hoppet som ett flicker (positionen är mitt i snap-animeringen).
            const sl = scroller.scrollLeft;
            const sNow = Math.round(sl / step);
            if (Math.abs(sl - sNow * step) > 2) {
              scrollDebounce = window.setTimeout(settle, 80);
              return;
            }
            if (sNow < n || sNow >= 2 * n) {
              suppressScrollUntil = Date.now() + 200;
              scroller.scrollLeft = ((((sNow % n) + n) % n) + n) * step;
            }
          };
          scrollDebounce = window.setTimeout(settle, 120);
        },
        { passive: true },
      );

      // Klick på klon = klick på originalet
      cloneEls.forEach((c) =>
        c.addEventListener("click", () => {
          const i = Number(c.dataset.clone);
          if (i === current) {
            togglePlay();
            return;
          }
          setActive(i);
          if (!reduce) {
            userPaused = false;
            play();
          }
        }),
      );
    }

    setActive(0);
    updateIcons();

    // Starta i mittsetet (riktiga items) så det finns kloner åt båda håll
    if (scroller && n > 1 && !mdQuery.matches) {
      scroller.scrollLeft = n * scrollStep();
    }

    if (reduce) return;
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            if (!userPaused) play();
          } else {
            pause();
          }
        },
        { threshold: 0.4 },
      );
      io.observe(root);
    } else {
      play();
    }
  });
</script>

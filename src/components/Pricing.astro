---
import Container from "./Container.astro";
import { BUY_SINGLE, BUY_TEAM } from "../lib/links";

// Pricing (redesign): två stora kort-knappar på gridden (4/12 kol vardera,
// centrerade). Hela kortet är klickbart — hover-fill och press-skala.
// Single = vit (invers yta), Team = mörk surface.
const plans = [
  { name: "Single License", price: "$69", href: BUY_SINGLE, featured: true },
  { name: "Team License", price: "$49", href: BUY_TEAM, featured: false },
];
const DESC = "No subscription. One-time purchase with 12 months of updates included.";
---

<section
  id="pricing"
  data-focus
  class="pt-[var(--space-4xl)] md:pt-[var(--space-6xl)]"
>
  <Container>
    <div data-reveal class="text-center">
      <h2 class="text-3xl text-text sm:text-4xl">Pay once. It's yours.</h2>
      <p class="mx-auto mt-4 max-w-sm text-lg text-text-muted">{DESC}</p>
    </div>

    <div data-reveal class="grid-12 mt-12 md:mt-[var(--space-3xl)]">
      {
        plans.map((plan, i) => (
          <a
            href={plan.href}
            class:list={[
              "press glare tilt holo group flex flex-col rounded-4xl p-8 sm:p-10 md:col-span-4",
              i === 0 && "md:col-start-3",
              plan.featured
                ? "bg-inverse-bg text-inverse-text [--glare-color:var(--glare-on-light)] [--holo-strength:var(--holo-strength-on-light)] [--holo-blend:multiply]"
                : "bg-surface text-text transition-colors hover:bg-surface-hover",
            ]}
          >
            <p class="text-lg">{plan.name}</p>
            <p
              class:list={[
                "mt-3 max-w-xs text-base",
                plan.featured ? "text-inverse-text-muted" : "text-text-muted",
              ]}
            >
              {DESC}
            </p>
            <div class="mt-16 flex items-baseline gap-2">
              <span class="text-4xl">{plan.price}</span>
              <span
                class:list={[
                  "text-base",
                  plan.featured
                    ? "text-inverse-text-muted"
                    : "text-text-muted",
                ]}
              >
                /seat
              </span>
            </div>
            <span
              class:list={[
                "mt-8 block rounded-xl py-3.5 text-center text-base transition-colors duration-[var(--duration-base)]",
                plan.featured
                  ? "bg-btn-inverse text-btn-inverse-text group-hover:bg-btn-inverse-hover"
                  : "bg-btn-secondary text-text group-hover:bg-btn-secondary-hover",
              ]}
            >
              Buy license
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-12 text-center text-sm text-text-muted">
      Need more than 10 seats?{" "}
      <a
        href="mailto:support@heydolly.app"
        class="text-text underline underline-offset-2 transition-colors hover:text-text-muted"
      >
        Contact us
      </a>
    </p>
  </Container>
</section>

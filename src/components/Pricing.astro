---
import Container from "./Container.astro";
import { BUY_SINGLE, BUY_TEAM } from "../lib/links";

// Pricing (redesign): per-seat. Två hårfint kantade license-rader + contact.
const plans = [
  { name: "Single License", price: "$69", href: BUY_SINGLE, featured: true },
  { name: "Team License", price: "$49", href: BUY_TEAM, featured: false },
];
const DESC = "No subscription. One-time purchase with 12 months of updates included.";
---

<section id="pricing" data-focus class="py-20 md:py-28">
  <Container>
    <div class="mx-auto max-w-2xl">
      <div data-reveal class="text-center">
        <h2 class="text-3xl text-text sm:text-4xl">Pay once. It's yours.</h2>
        <p class="mx-auto mt-4 max-w-sm text-lg text-text-muted">{DESC}</p>
      </div>

      <div data-reveal class="mt-12 flex flex-col gap-4 md:mt-[var(--space-3xl)]">
        {
          plans.map((plan) => (
            <div
              class:list={[
                "rounded-md p-6 transition-colors duration-[var(--duration-base)] sm:p-7",
                plan.featured
                  ? "bg-surface hover:bg-surface-elevated"
                  : "border border-border hover:border-border-strong",
              ]}
            >
              <p class="text-lg text-text">{plan.name}</p>
              <p class="mt-2 max-w-sm text-sm text-text-muted">{DESC}</p>
              <div class="mt-6 flex items-center justify-between gap-4">
                <div class="flex items-baseline gap-1.5">
                  <span class="text-3xl text-text">{plan.price}</span>
                  <span class="text-sm text-text-muted">/seat</span>
                </div>
                <a
                  href={plan.href}
                  class="press shrink-0 rounded-lg bg-btn-primary px-5 py-2.5 text-sm text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
                >
                  Buy license
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-center text-sm text-text-muted">
        Need more than 10 seats?{" "}
        <a
          href="mailto:support@heydolly.app"
          class="text-text underline underline-offset-2 transition-colors hover:text-text-muted"
        >
          Contact us
        </a>
      </p>
    </div>
  </Container>
</section>

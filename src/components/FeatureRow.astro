---
// Split feature-rad: media + text. Mobil: media överst, text under.
// Desktop: sida vid sida; reverse=true lägger media till vänster.
interface Props {
  title: string;
  body: string;
  media?: string;
  video?: string;
  reverse?: boolean;
}
const { title, body, media = "Video", video, reverse = false } = Astro.props;
---

<div data-reveal class="grid items-center gap-6 sm:grid-cols-2 sm:gap-16">
  <div
    class:list={[
      "order-2 flex flex-col gap-4",
      reverse ? "sm:order-2" : "sm:order-1",
    ]}
  >
    <h3
      class="font-display text-xl font-bold tracking-[-0.02em] text-text sm:text-3xl"
    >
      {title}
    </h3>
    <p class="max-w-md text-lg text-text-muted">{body}</p>
  </div>
  <div
    class:list={[
      "order-1 flex aspect-square items-center justify-center overflow-hidden rounded-sm bg-surface sm:rounded-lg",
      reverse ? "sm:order-1" : "sm:order-2",
    ]}
  >
    {
      video ? (
        <video
          class="h-full w-full object-cover"
          data-autopause
          muted
          loop
          playsinline
          preload="metadata"
        >
          <source src={video} type="video/mp4" />
        </video>
      ) : (
        <span class="text-sm text-text-subtle">{media}</span>
      )
    }
  </div>
</div>

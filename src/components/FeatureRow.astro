---
// Split feature-rad: text på ena sidan, media (video-platshållare) på andra.
// reverse=true lägger media till vänster på desktop.
interface Props {
  kicker?: string;
  title: string;
  body: string;
  media?: string;
  video?: string;
  reverse?: boolean;
}
const {
  kicker,
  title,
  body,
  media = "Video",
  video,
  reverse = false,
} = Astro.props;
---

<div data-reveal class="grid items-center gap-10 sm:grid-cols-2 sm:gap-16">
  <div class:list={["flex flex-col gap-4", reverse && "sm:order-2"]}>
    {kicker && <span class="text-sm font-medium text-accent">{kicker}</span>}
    <h3
      class="font-display text-2xl font-bold tracking-[-0.02em] text-text sm:text-3xl"
    >
      {title}
    </h3>
    <p class="max-w-md text-lg text-text-muted">{body}</p>
  </div>
  <div
    class:list={[
      "flex aspect-square items-center justify-center overflow-hidden rounded-sm bg-surface sm:rounded-lg",
      reverse && "sm:order-1",
    ]}
  >
    {
      video ? (
        <video
          class="h-full w-full object-cover"
          data-autopause
          muted
          loop
          playsinline
          preload="metadata"
        >
          <source src={video} type="video/mp4" />
        </video>
      ) : (
        <span class="text-sm text-text-subtle">{media}</span>
      )
    }
  </div>
</div>

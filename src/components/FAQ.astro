---
import Container from "./Container.astro";

// FAQ (redesign) — samma innehåll som v1, stylad enligt nya designen:
// centrerad sektionsrubrik, hårfina delare, +-ikon som roterar, mjuk
// höjd-animering. En vikt — betoning via färg, inte font-weight.
const faqs = [
  {
    q: "Is Dolly a subscription?",
    a: "No. Dolly is a one-time purchase, and every version we release after it is included. There is nothing to renew.",
  },
  {
    q: "What Mac do I need?",
    a: "Any Mac with Apple silicon or Intel, running macOS 15 (Sequoia) or later.",
  },
  {
    q: "Where are my recordings stored?",
    a: "Locally, on your Mac. Dolly runs entirely on-device and nothing is uploaded.",
  },
  {
    q: "How do updates work?",
    a: "Dolly updates itself automatically, and your license covers every version we release — no renewal, no extra cost.",
  },
  {
    q: "Can I get a refund?",
    a: "Yes. Checkout and refunds are handled by Polar, our payment provider.",
  },
];
---

<section
  id="faq"
  data-reveal
  class="py-flow-2xl"
>
  <Container>
    <div class="mx-auto max-w-xl text-center">
      <h2 data-reveal-item class="text-xl text-text tracking-[-0.5px] sm:text-2xl sm:tracking-[-1px]">Asked about Dolly.</h2>
    </div>

    <div data-reveal-item class="mx-auto mt-flow-lg flex max-w-2xl flex-col gap-1">
      {
        faqs.map((item) => (
          <details class="faq group rounded-md md:rounded-xl transition-colors duration-[var(--duration-base)] hover:bg-surface">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-base text-text marker:content-none sm:text-lg">
              {item.q}
              <svg
                class="size-4 shrink-0 text-text-subtle transition-transform duration-[var(--duration-base)] group-open:rotate-180"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 6l4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <div class="faq-panel overflow-hidden">
              <p class="max-w-xl px-6 pb-6 text-sm text-text-muted sm:text-base">
                {item.a}
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </Container>
</section>

<style>
  /* Mobil (ingen hover): öppnad item får samma fyllning som desktop-hovern */
  @media (width < 40rem) {
    details.faq[open] {
      background-color: var(--surface);
    }
  }
</style>

<script>
  // Dragspel: en fråga öppen åt gången. Öppnas en ny viks den förra ihop.
  // Höjden animeras mjukt (och hoppas över vid reduced-motion).
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";

  const items = [
    ...document.querySelectorAll<HTMLDetailsElement>("details.faq"),
  ]
    .map((d) => {
      const summary = d.querySelector("summary");
      const panel = d.querySelector<HTMLElement>(".faq-panel");
      if (!summary || !panel) return null;
      let anim: Animation | null = null;
      // Räknare så ett fördröjt avslut inte stänger en panel som hunnit
      // öppnas igen under tiden.
      let gen = 0;

      const open = () => {
        gen++;
        anim?.cancel();
        d.open = true;
        anim = panel.animate(
          [
            { height: "0px", opacity: 0 },
            { height: panel.scrollHeight + "px", opacity: 1 },
          ],
          { duration: 280, easing: EASE },
        );
        anim.onfinish = () => (panel.style.height = "");
      };

      const close = () => {
        if (!d.open) return;
        const mine = ++gen;
        // Höjden mäts innan animeringen börjar; en pågående animering
        // skulle annars ge ett halvvägs värde att utgå från.
        const from = panel.scrollHeight + "px";
        anim?.cancel();
        anim = panel.animate(
          [
            { height: from, opacity: 1 },
            { height: "0px", opacity: 0 },
          ],
          { duration: 240, easing: EASE },
        );
        const settle = () => {
          if (mine !== gen) return; // hann öppnas igen
          d.open = false;
          panel.style.height = "";
        };
        anim.onfinish = settle;
        // Säkerhetsnät: levereras aldrig animationens callback — avbruten
        // animering, bakgrundsflik — blir panelen annars stående öppen och
        // två frågor syns samtidigt.
        window.setTimeout(settle, 400);
      };

      return { d, summary, open, close };
    })
    .filter((x) => x !== null);

  for (const item of items) {
    item.summary.addEventListener("click", (e) => {
      if (reduce) {
        // Native togglar själv; vi ser bara till att bara en är öppen.
        requestAnimationFrame(() => {
          if (!item.d.open) return;
          for (const other of items) if (other !== item) other.d.open = false;
        });
        return;
      }
      e.preventDefault();
      if (item.d.open) {
        item.close();
        return;
      }
      for (const other of items) if (other !== item) other.close();
      item.open();
    });
  }
</script>

---
import Container from "./Container.astro";
import { getDownloadUrl, BUY_SINGLE } from "../lib/links";

// Mörk full-bredds-nav (redesign). Logo vänster, två knappar höger.
const DMG = await getDownloadUrl(); // senaste DMG från appcasten
const BUY = BUY_SINGLE;
---

<header
  class="sticky top-0 z-50 bg-bg/80 backdrop-blur-md"
>
  <Container class="flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="Dolly">
      <img src="/dolly-logo-single.svg" alt="" class="h-5 w-5 [filter:invert(1)]" />
      <span class="text-lg tracking-tight text-text">Dolly</span>
    </a>
    <div class="flex items-center gap-2">
      <a
        href={DMG}
        class="rounded-lg bg-btn-secondary px-4 py-2 text-sm text-text backdrop-blur-md transition-colors hover:bg-btn-secondary-hover"
      >
        Download for Mac
      </a>
      <a
        href={BUY}
        class="rounded-lg bg-btn-primary px-4 py-2 text-sm text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
      >
        Buy now
      </a>
    </div>
  </Container>
</header>

---
import Container from "./Container.astro";
import { getDownloadUrl } from "../lib/links";

// Mörk full-bredds-nav (redesign). Logo + ankarmeny vänster, knappar höger.
// Vid scroll åker hela raden upp ur bild och en kompakt orb med logo och
// Buy now åker in ovanifrån. Buy now ankrar ner till pricing-sektionen.
const DMG = await getDownloadUrl(); // senaste DMG från appcasten
const menu = [
  { label: "Features", href: "/#features" },
  { label: "Pricing", href: "/#pricing" },
  { label: "Use cases", href: "/#use-cases" },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div data-nav class="relative h-32">
    <!-- Full nav. Fade-gradienten ligger inuti wrappern, så en enda transform
         tar med sig både raden och faden ur bild. -->
    <div data-nav-full class="absolute inset-0">
      <!-- Fade-gradient: bg → transparent med easing-steg, mjukt tak utan
           hård kant. -->
      <div aria-hidden="true" class="nav-fade absolute inset-0"></div>
      <Container
        class="pointer-events-auto relative flex h-16 items-center justify-between"
      >
        <div class="flex items-center gap-[var(--space-xl)]">
          <a
            href="/"
            class="flex items-center transition-opacity duration-[var(--duration-base)] hover:opacity-70"
            aria-label="Dolly"
          >
            <img src="/dolly-logo.svg" alt="Dolly" class="h-5 w-auto" />
          </a>
          <nav class="hidden items-center gap-[var(--space-md)] sm:flex">
            {
              menu.map((item) => (
                <a
                  href={item.href}
                  class="text-base text-text transition-colors duration-[var(--duration-base)] hover:text-text-muted"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="flex items-center gap-2">
          <a
            href={DMG}
            data-download
            class="press hidden rounded-pill bg-btn-secondary px-4 py-2 text-sm text-text backdrop-blur-md transition-colors hover:bg-btn-secondary-hover sm:block"
          >
            Download for Mac
          </a>
          <a
            href="/#pricing"
            class="press rounded-pill bg-btn-primary px-4 py-2 text-sm text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
          >
            Buy now
          </a>
        </div>
      </Container>
    </div>

    <!-- Orben. Egen rad ovanpå, centrerad. Wrappern sköter centreringen så
         orbens transform bara behöver hantera in- och utåkningen. -->
    <div
      class="pointer-events-none absolute inset-x-0 top-2 flex justify-center"
    >
      <div
        class="nav-orb pointer-events-auto flex items-center gap-[var(--space-xl)] rounded-pill py-2 pr-2 pl-5"
      >
        <a
          href="/"
          class="flex items-center transition-opacity duration-[var(--duration-base)] hover:opacity-70"
          aria-label="Dolly"
        >
          <img src="/dolly-logo.svg" alt="Dolly" class="h-5 w-auto" />
        </a>
        <a
          href="/#pricing"
          class="press rounded-pill bg-btn-primary px-4 py-2 text-sm whitespace-nowrap text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
        >
          Buy now
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Sekvens: den fulla raden åker upp ur bild, sedan kommer orben in
     ovanifrån med lite överlapp så det inte uppstår en död lucka.
     Bakvägen spelas samma sekvens baklänges — därför står transition i
     BÅDA tillstånden, den som gäller är alltid destinationens.

     visibility växlas i samma veva som rörelsen, så bara det som syns går
     att tabba till eller läsa upp. Annars ligger båda uppsättningarna
     länkar kvar för tangentbord och skärmläsare. */
  :root {
    --nav-t-out: 300ms; /* det som lämnar */
    --nav-t-in: 340ms; /* det som kommer */
    --nav-t-overlap: 180ms; /* när inflytten börjar */
  }

  .nav-fade {
    /* Smoothstep-profil (9 steg) istället för linjär tvåstegsfade —
       samma höjd, men utfasningen accelererar/bromsar mjukt. */
    background: linear-gradient(
      to bottom,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 96%, transparent) 12%,
      color-mix(in srgb, var(--bg) 87%, transparent) 25%,
      color-mix(in srgb, var(--bg) 71%, transparent) 40%,
      color-mix(in srgb, var(--bg) 50%, transparent) 55%,
      color-mix(in srgb, var(--bg) 29%, transparent) 70%,
      color-mix(in srgb, var(--bg) 13%, transparent) 82%,
      color-mix(in srgb, var(--bg) 4%, transparent) 92%,
      transparent 100%
    );
  }

  /* Full nav — kommer in sist på vägen tillbaka */
  [data-nav-full] {
    transform: translate3d(0, 0, 0);
    visibility: visible;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition:
      transform var(--nav-t-in) var(--ease-out-quart) var(--nav-t-overlap),
      visibility 0s linear var(--nav-t-overlap);
  }
  [data-orb] [data-nav-full] {
    transform: translate3d(0, -100%, 0);
    visibility: hidden;
    transition:
      transform var(--nav-t-out) var(--ease-out-quart) 0ms,
      visibility 0s linear var(--nav-t-out);
  }

  /* Orben: mörkgrå platta med blur, inget glas. Ljusare än sidbakgrunden
     så den läser som ett eget lager även när den ligger över mörkt
     innehåll — mot sidbakgrundens svarta hade den försvunnit. */
  .nav-orb {
    background: color-mix(in srgb, var(--surface-elevated) 88%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    /* -180% av 52px lyfter den väl ovanför skärmkanten */
    transform: translate3d(0, -180%, 0);
    visibility: hidden;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    /* går ut först på vägen tillbaka */
    transition:
      transform var(--nav-t-out) var(--ease-out-quart) 0ms,
      visibility 0s linear var(--nav-t-out);
  }
  [data-orb] .nav-orb {
    transform: translate3d(0, 0, 0);
    visibility: visible;
    transition:
      transform var(--nav-t-in) var(--ease-out-quart) var(--nav-t-overlap),
      visibility 0s linear var(--nav-t-overlap);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-nav-full],
    [data-orb] [data-nav-full],
    .nav-orb,
    [data-orb] .nav-orb {
      transition: none;
    }
  }
</style>

<script>
  // Full nav nära toppen, orb när man har scrollat förbi. Positionsstyrt,
  // inte riktningsstyrt: orben ska vara ett stabilt läge, inte något som
  // blinkar fram och tillbaka när man byter scrollriktning.
  // Desktop-only — på mobil finns ingen meny att byta bort.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const desktop = matchMedia("(min-width: 768px)");
  if (nav) {
    const TOP = 80; // px från sidtoppen där hela navet visas
    let ticking = false;

    const update = () => {
      nav.toggleAttribute("data-orb", desktop.matches && scrollY > TOP);
      ticking = false;
    };

    desktop.addEventListener("change", update);
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

---
import Container from "./Container.astro";

// Mörk full-bredds-nav (redesign). Logo vänster, två knappar höger.
// TODO: koppla auto-DMG + Polar när shell:et står.
const DMG = "https://updates.heydolly.app/Dolly-1.0.1.dmg";
const BUY = "https://buy.polar.sh/polar_cl_twiEvKa2nqt7k2bPyNEMGlCkmiZydNOUvPIyU105wyO";
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md"
>
  <Container class="flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="Dolly">
      <img src="/dolly-logo-single.svg" alt="" class="h-5 w-5 [filter:invert(1)]" />
      <span class="text-lg tracking-tight text-text">Dolly</span>
    </a>
    <div class="flex items-center gap-2">
      <a
        href={DMG}
        class="rounded-pill border border-border-strong px-4 py-2 text-sm text-text transition-colors hover:bg-surface"
      >
        Download for Mac
      </a>
      <a
        href={BUY}
        class="rounded-pill bg-btn-primary px-4 py-2 text-sm text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
      >
        Buy now
      </a>
    </div>
  </Container>
</header>

---
import Container from "./Container.astro";
import { getDownloadUrl } from "../lib/links";

// Mörk full-bredds-nav (redesign). Logo + ankarmeny vänster, knappar höger.
// Två oberoende lägen vid scroll: raden åker upp ur bild tidigt, och längre
// ned kommer en kompakt orb med logo och Buy now in ovanifrån. Däremellan
// syns inget nav. Buy now ankrar ner till pricing-sektionen.
interface Props {
  /** Orben behövs bara på sidor med långt innehåll (startsidan). */
  orb?: boolean;
}
const { orb = true } = Astro.props;
const DMG = await getDownloadUrl(); // senaste DMG från appcasten
const menu = [
  { label: "Features", href: "/#features" },
  { label: "Pricing", href: "/#pricing" },
  { label: "Use cases", href: "/#use-cases" },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div data-nav class="relative h-32">
    <!-- Full nav. Fade-gradienten ligger inuti wrappern, så en enda transform
         tar med sig både raden och faden ur bild. -->
    <div data-nav-full class="absolute inset-0">
      <!-- Fade-gradient: bg → transparent med easing-steg, mjukt tak utan
           hård kant. -->
      <div aria-hidden="true" class="nav-fade absolute inset-0"></div>
      <Container
        class="pointer-events-auto relative flex h-16 items-center justify-between"
      >
        <div class="flex items-center gap-[var(--space-xl)]">
          <a
            href="/"
            class="flex items-center transition-opacity duration-[var(--duration-base)] hover:opacity-70"
            aria-label="Dolly"
          >
            <img src="/dolly-logo.svg" alt="Dolly" class="h-5 w-auto" />
          </a>
          <nav class="hidden items-center gap-[var(--space-md)] sm:flex">
            {
              menu.map((item) => (
                <a
                  href={item.href}
                  class="text-base text-text transition-colors duration-[var(--duration-base)] hover:text-text-muted"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="flex items-center gap-2">
          <a
            href={DMG}
            data-download
            class="press hidden rounded-pill bg-btn-secondary px-4 py-2 text-sm text-text backdrop-blur-md transition-colors hover:bg-btn-secondary-hover sm:block"
          >
            Download for Mac
          </a>
          <a
            href="/#pricing"
            class="press rounded-pill bg-btn-primary px-4 py-2 text-sm text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
          >
            Buy now
          </a>
        </div>
      </Container>
    </div>

    {
      /* Orben. Egen rad ovanpå, centrerad. Wrappern sköter centreringen så
         orbens transform bara behöver hantera in- och utåkningen. */
      orb && (
        <div class="pointer-events-none absolute inset-x-0 top-2 flex justify-center">
          <div class="nav-orb pointer-events-auto relative flex items-center gap-[var(--space-xl)] rounded-pill py-2 pr-2 pl-5">
            {/* Glasets mätyta. liquidGL skriver inline-stilar på sitt target
                (transparent bakgrund, pointer-events: none, transition: none)
                — det får gälla ett tomt lager, inte orben själv. */}
            <div class="nav-orb-glass" aria-hidden="true" />
            <a
              href="/"
              class="flex items-center transition-opacity duration-[var(--duration-base)] hover:opacity-70"
              aria-label="Dolly"
            >
              <img src="/dolly-logo.svg" alt="Dolly" class="h-5 w-auto" />
            </a>
            <a
              href="/#pricing"
              class="press rounded-pill bg-btn-primary px-4 py-2 text-sm whitespace-nowrap text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
            >
              Buy now
            </a>
          </div>
        </div>
      )
    }
  </div>
</header>

<style>
  /* Två oberoende lägen, inte en sekvens: [data-hidden] tar bort raden strax
     under sidtoppen, [data-orb] hämtar in orben långt senare. Däremellan
     finns inget nav, så de behöver inte vänta in varandra.

     visibility växlas i takt med rörelsen, så bara det som syns går att
     tabba till eller läsa upp. Annars ligger båda uppsättningarna länkar
     kvar för tangentbord och skärmläsare. */
  :root {
    --nav-t-out: 300ms;
    --nav-t-in: 340ms;
  }

  .nav-fade {
    /* Smoothstep-profil (9 steg) istället för linjär tvåstegsfade —
       samma höjd, men utfasningen accelererar/bromsar mjukt. */
    background: linear-gradient(
      to bottom,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 96%, transparent) 12%,
      color-mix(in srgb, var(--bg) 87%, transparent) 25%,
      color-mix(in srgb, var(--bg) 71%, transparent) 40%,
      color-mix(in srgb, var(--bg) 50%, transparent) 55%,
      color-mix(in srgb, var(--bg) 29%, transparent) 70%,
      color-mix(in srgb, var(--bg) 13%, transparent) 82%,
      color-mix(in srgb, var(--bg) 4%, transparent) 92%,
      transparent 100%
    );
  }

  [data-nav-full] {
    transform: translate3d(0, 0, 0);
    visibility: visible;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition:
      transform var(--nav-t-in) var(--ease-out-quart),
      visibility 0s linear 0s;
  }
  [data-hidden] [data-nav-full] {
    transform: translate3d(0, -100%, 0);
    visibility: hidden;
    transition:
      transform var(--nav-t-out) var(--ease-out-quart),
      visibility 0s linear var(--nav-t-out);
  }

  /* Orben: mörkgrå platta med blur, inget glas. Ljusare än sidbakgrunden
     så den läser som ett eget lager även över mörkt innehåll. */
  .nav-orb {
    background: color-mix(in srgb, var(--surface-elevated) 88%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    /* Blur-plattan är grundläget och det som syns om WebGL saknas.
       Lyckas liquidGL tar den över och plattan kopplas bort. */
    /* -180% av 52px lyfter den väl ovanför skärmkanten */
    transform: translate3d(0, -180%, 0);
    visibility: hidden;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition:
      transform var(--nav-t-out) var(--ease-out-quart),
      visibility 0s linear var(--nav-t-out);
  }
  [data-orb] .nav-orb {
    transform: translate3d(0, 0, 0);
    visibility: visible;
    transition:
      transform var(--nav-t-in) var(--ease-out-quart),
      visibility 0s linear 0s;
  }

  .nav-orb-glass {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  /* Brytningen renderas i en canvas bakom headern, så orbens egen bakgrund
     hamnar ovanpå den och fungerar som toning. Behövs för att logotypen ska
     hålla mot vita partier som passerar under. */
  .nav-orb[data-gl] {
    background: rgba(40, 40, 40, 0.4);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-nav-full],
    [data-hidden] [data-nav-full],
    .nav-orb,
    [data-orb] .nav-orb {
      transition: none;
    }
  }
</style>

<script>
  // Positionsstyrt, inte riktningsstyrt: lägena ska vara stabila och inte
  // blinka fram och tillbaka när man byter scrollriktning.
  //   > TOP              → raden åker upp ur bild
  //   > data-nav-trigger → orben kommer in
  // Desktop-only; på mobil ligger raden kvar hela vägen.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const orb = document.querySelector<HTMLElement>(".nav-orb");
  // Sidan pekar ut var orben ska komma: när elementet med data-nav-trigger
  // har passerat skärmens överkant.
  const trigger = document.querySelector<HTMLElement>("[data-nav-trigger]");
  const desktop = matchMedia("(min-width: 768px)");
  if (nav) {
    const TOP = 80; // px från sidtoppen där raden lämnar
    const HYST = 48; // hysteres, annars kan orben blinka vid tröskeln
    let triggerY = Infinity; // utan trigger kommer orben aldrig
    let ticking = false;

    // offsetTop-kedjan, inte getBoundingClientRect: hero-videon skalas av en
    // scroll-driven animation och rect:en följer transformen.
    const measure = () => {
      if (!trigger) return;
      let y = trigger.offsetHeight;
      let node: HTMLElement | null = trigger;
      while (node) {
        y += node.offsetTop;
        node = node.offsetParent as HTMLElement | null;
      }
      triggerY = y;
    };

    const update = () => {
      // Raden lämnar bara där orben finns som ersättare. På sidor utan orb
      // (de juridiska) ligger den kvar — annars försvinner navet vid 80px
      // och kommer aldrig tillbaka förrän man scrollat upp igen.
      const wide = desktop.matches && !!orb;
      nav.toggleAttribute("data-hidden", wide && scrollY > TOP);
      if (orb) {
        const on = nav.hasAttribute("data-orb");
        const past = scrollY > (on ? triggerY - HYST : triggerY);
        nav.toggleAttribute("data-orb", wide && past);
      }
      ticking = false;
    };

    const remeasure = () => {
      measure();
      update();
    };

    desktop.addEventListener("change", update);
    addEventListener("resize", remeasure, { passive: true });
    addEventListener("load", remeasure);
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    remeasure();
  }
</script>

<script>
  // Liquid glass i orben (liquidGL, MIT). Biblioteket rasteriserar sidan till
  // en WebGL-textur och bryter den bakom elementet — därav den riktiga
  // förvrängningen som backdrop-filter inte kan ge.
  //
  // Laddas dynamiskt och bara där orben finns, så de juridiska sidorna
  // slipper ~130 kB JS. Misslyckas något ligger CSS-blurren kvar.
  const orb = document.querySelector<HTMLElement>(".nav-orb");
  const glassLayer = document.querySelector<HTMLElement>(".nav-orb-glass");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (orb && glassLayer && !reduce) {
    const start = async () => {
      try {
        const { default: liquidGL } = await import("liquid-gl");
        liquidGL({
          target: ".nav-orb-glass",
          snapshot: "body",
          // Sidan är närmare 8000px hög. resolution 2 ger en textur runt
          // 15000px, obehagligt nära GPU-taket på 16384 — och orben är bara
          // 229px bred, så skärpan behövs inte.
          resolution: 1.5,
          refraction: 0.05,
          bevelDepth: 0.1,
          bevelWidth: 0.18,
          aberration: 0.1,
          // frost är en blurradie i pixlar, inte 0-1. Bibliotekets egen
          // balanserade default ligger på 2.
          frost: 2.5,
          specular: true,
          shadow: true,
          tilt: false,
          reveal: "none",
        });
        if (!window.__liquidGLRenderer__) return;
        orb.setAttribute("data-gl", "");

        // Texturen är en stillbild av sidan. Sektionerna som glider in
        // ändrar hur sidan ser ut efteråt, så den måste tas om.
        let pending: number | undefined;
        addEventListener("dolly:layoutchange", () => {
          clearTimeout(pending);
          pending = setTimeout(
            () => window.__liquidGLRenderer__?.captureSnapshot?.(),
            120,
          );
        });
      } catch (err) {
        console.warn("liquidGL kunde inte starta, behåller css-blurren", err);
      }
    };
    // Efter load: snapshotten ska avbilda en färdig sida, inte en halv.
    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>

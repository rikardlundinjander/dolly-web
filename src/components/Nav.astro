---
import Container from "./Container.astro";
import { getDownloadUrl } from "../lib/links";

// Mörk full-bredds-nav (redesign). Logo + ankarmeny vänster, knappar höger.
// Buy now ankrar ner till pricing-sektionen (köpet sker via korten där).
const DMG = await getDownloadUrl(); // senaste DMG från appcasten
const menu = [
  { label: "Features", href: "/#features" },
  { label: "Pricing", href: "/#pricing" },
  { label: "Use cases", href: "/#use-cases" },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div data-nav class="relative">
    <!-- Fade-gradient: bg → transparent med easing-steg, mjukt tak utan hård kant -->
    <div
      aria-hidden="true"
      class="nav-fade pointer-events-none absolute inset-x-0 top-0 -z-10 h-[200%]"
    >
    </div>
    <Container class="flex h-16 items-center justify-between">
    <div class="flex items-center gap-[var(--space-xl)]">
      <a
        href="/"
        class="flex items-center transition-opacity duration-[var(--duration-base)] hover:opacity-70"
        aria-label="Dolly"
      >
        <img src="/dolly-logo.svg" alt="Dolly" class="h-5 w-auto" />
      </a>
      <nav class="hidden items-center gap-[var(--space-md)] sm:flex">
        {
          menu.map((item) => (
            <a
              href={item.href}
              class="text-base text-text transition-colors duration-[var(--duration-base)] hover:text-text-muted"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="flex items-center gap-2">
      <a
        href={DMG}
        class="press hidden rounded-pill bg-btn-secondary px-4 py-2 text-sm text-text transition-colors hover:bg-btn-secondary-hover sm:block"
      >
        Download for Mac
      </a>
      <a
        href="/#pricing"
        class="press rounded-pill bg-btn-primary px-4 py-2 text-sm text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
      >
        Buy now
      </a>
      </div>
    </Container>
  </div>
</header>

<style>
  /* Smoothstep-profil (9 steg) istället för linjär tvåstegsfade —
     samma höjd, men utfasningen accelererar/bromsar mjukt. */
  .nav-fade {
    background: linear-gradient(
      to bottom,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 96%, transparent) 12%,
      color-mix(in srgb, var(--bg) 87%, transparent) 25%,
      color-mix(in srgb, var(--bg) 71%, transparent) 40%,
      color-mix(in srgb, var(--bg) 50%, transparent) 55%,
      color-mix(in srgb, var(--bg) 29%, transparent) 70%,
      color-mix(in srgb, var(--bg) 13%, transparent) 82%,
      color-mix(in srgb, var(--bg) 4%, transparent) 92%,
      transparent 100%
    );
    transition: opacity var(--duration-base) var(--ease-out-quart);
  }

  /* Göms vid scroll ner, glider in vid scroll upp. Faden tonas bort helt
     (den är högre än navet och skulle annars sticka ut under kanten). */
  /* translate3d i båda lägena + will-change håller wrappern på ett eget
     compositor-lager. Safari räknar annars om sticky-positionen per frame
     när transformen sitter på själva sticky-elementet. */
  [data-nav] {
    transform: translate3d(0, 0, 0);
    will-change: transform;
    transition: transform var(--duration-base) var(--ease-out-quart);
  }
  [data-nav][data-hidden] {
    transform: translate3d(0, -100%, 0);
  }
  [data-nav][data-hidden] .nav-fade {
    opacity: 0;
  }
  .nav-fade {
    will-change: opacity;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-nav],
    .nav-fade {
      transition: none;
    }
  }
</style>

<script>
  // Auto-hide: göm navet när man scrollar ner, visa vid scroll upp.
  // Alltid synligt nära toppen. Tröskel mot jitter, rAF-throttlad.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const TOP = 80; // px från sidtoppen där navet alltid visas
    const DELTA = 12; // minsta rörelse som räknas som riktningsbyte
    let last = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const diff = y - last;
      if (y <= TOP) {
        nav.removeAttribute("data-hidden");
        last = y;
      } else if (Math.abs(diff) > DELTA) {
        nav.toggleAttribute("data-hidden", diff > 0);
        last = y;
      }
      ticking = false;
    };

    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>

---
import Container from "./Container.astro";
import { getDownloadUrl } from "../lib/links";

// Mörk full-bredds-nav (redesign). Logo + ankarmeny vänster, knappar höger.
// Vid scroll krymper den till en glasorb med bara logo och Buy now — se
// [data-orb] längre ned. Buy now ankrar ner till pricing-sektionen.
const DMG = await getDownloadUrl(); // senaste DMG från appcasten
const menu = [
  { label: "Features", href: "/#features" },
  { label: "Pricing", href: "/#pricing" },
  { label: "Use cases", href: "/#use-cases" },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div data-nav class="relative h-32">
    <!-- Fade-gradient: bg → transparent med easing-steg, mjukt tak utan hård
         kant. Tonas bort i orb-läget så orben ligger fritt över innehållet. -->
    <div aria-hidden="true" class="nav-fade absolute inset-0"></div>
    <Container class="relative h-16">
      <!-- Raden är bredare än orben men aldrig bredare än sidan. Klickytorna
           ligger på barnen, inte på raden: annars hade en osynlig remsa tvärs
           över sidan ätit klick och hover på innehållet under. -->
      <div class="nav-bar pointer-events-none relative flex h-full items-center">
        <div
          class="nav-glass pointer-events-none absolute inset-0 rounded-pill"
          aria-hidden="true"
        >
        </div>

        <a
          href="/"
          data-nav-logo
          class="pointer-events-auto relative flex shrink-0 items-center transition-opacity duration-[var(--duration-base)] hover:opacity-70"
          aria-label="Dolly"
        >
          <img src="/dolly-logo.svg" alt="Dolly" class="h-5 w-auto" />
        </a>

        <div class="nav-collapse hidden shrink-0 sm:grid">
          <nav
            class="pointer-events-auto flex items-center gap-[var(--space-md)] pl-[var(--space-xl)]"
          >
            {
              menu.map((item) => (
                <a
                  href={item.href}
                  class="text-base text-text transition-colors duration-[var(--duration-base)] hover:text-text-muted"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="nav-spacer"></div>

        <div class="nav-collapse hidden shrink-0 sm:grid">
          <div class="pr-2">
            <a
              href={DMG}
              data-download
              class="press pointer-events-auto block rounded-pill bg-btn-secondary px-4 py-2 text-sm whitespace-nowrap text-text backdrop-blur-md transition-colors hover:bg-btn-secondary-hover"
            >
              Download for Mac
            </a>
          </div>
        </div>

        <a
          href="/#pricing"
          data-nav-buy
          class="press pointer-events-auto relative shrink-0 rounded-pill bg-btn-primary px-4 py-2 text-sm whitespace-nowrap text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
        >
          Buy now
        </a>
      </div>
    </Container>
  </div>
</header>

<style>
  /* Iscensättning i tre steg i stället för allt på en gång:
       1. det som inte följer med tonas bort
       2. logo och knapp glider ihop mot mitten
       3. glaset lägger sig på
     Bakvägen spelas sekvensen baklänges. Därför står transition i BÅDA
     tillstånden — den som gäller är alltid destinationens. */
  :root {
    --nav-t-fade: 140ms; /* steg 1 */
    --nav-t-morph: 380ms; /* steg 2 */
    --nav-t-glass: 280ms; /* steg 3 */
  }

  /* Smoothstep-profil (9 steg) istället för linjär tvåstegsfade —
     samma höjd, men utfasningen accelererar/bromsar mjukt. */
  .nav-fade {
    background: linear-gradient(
      to bottom,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 96%, transparent) 12%,
      color-mix(in srgb, var(--bg) 87%, transparent) 25%,
      color-mix(in srgb, var(--bg) 71%, transparent) 40%,
      color-mix(in srgb, var(--bg) 50%, transparent) 55%,
      color-mix(in srgb, var(--bg) 29%, transparent) 70%,
      color-mix(in srgb, var(--bg) 13%, transparent) 82%,
      color-mix(in srgb, var(--bg) 4%, transparent) 92%,
      transparent 100%
    );
    /* tillbaka: sist av allt */
    transition: opacity var(--nav-t-fade) linear
      calc(var(--nav-t-glass) + var(--nav-t-morph));
  }

  /* Baren går från full bredd till orbens bredd via max-width, och glaset
     (inset-0) hugger den utan egen positionering. Orbens bredd beror på
     logotypens och knappens mått, så scriptet mäter den en gång och skriver
     den till --orb-w. fit-content duger inte: en krympbar spacer räknas inte
     in i max-content, så baren hade kollapsat runt innehållet i vidläget. */
  .nav-bar {
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    padding: 0;
    transform: translate3d(0, 0, 0);
    transition:
      max-width var(--nav-t-morph) var(--ease-out-quart) var(--nav-t-glass),
      height var(--nav-t-morph) var(--ease-out-quart) var(--nav-t-glass),
      padding var(--nav-t-morph) var(--ease-out-quart) var(--nav-t-glass),
      transform var(--nav-t-morph) var(--ease-out-quart) var(--nav-t-glass);
  }

  /* Spacern växer i båda lägena och trycker alltid knappen mot högerkanten.
     Luckan i orb-läget sätts med min-width, inte med en fast flex-basis:
     med fast basis stod knappen kvar intill logotypen med tom yta efter sig
     under hela morfen, eftersom inget annat kunde fylla ut baren. */
  .nav-spacer {
    flex: 1 1 0;
    min-width: 0;
  }

  /* 1fr → 0fr viker ihop bredden utan att vi behöver mäta något.
     Barnet klipper sitt innehåll så texten inte radbryts på vägen ut. */
  .nav-collapse {
    grid-template-columns: 1fr;
    transition:
      grid-template-columns var(--nav-t-morph) var(--ease-out-quart)
        var(--nav-t-glass),
      opacity var(--nav-t-fade) linear
        calc(var(--nav-t-glass) + var(--nav-t-morph));
  }
  .nav-collapse > * {
    min-width: 0;
    overflow: hidden;
    transition: padding var(--nav-t-morph) var(--ease-out-quart)
      var(--nav-t-glass);
  }

  /* Glaset. Eget lager bakom innehållet som bara tonas in — backdrop-filtret
     självt ligger still, det är dyrt att interpolera och hackar i Safari.
     Tre lager: grundbrytning (blur/saturate + ljus uppifrån), specular
     highlight (::before) och en brytningskant (::after) där bakgrunden är
     extra suddad och ljusare, vilket är det som läser som glastjocklek. */
  .nav-glass {
    background:
      linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.1) 0%,
        rgba(255, 255, 255, 0.03) 45%,
        rgba(255, 255, 255, 0) 62%,
        rgba(255, 255, 255, 0.05) 100%
      ),
      color-mix(in srgb, var(--bg) 38%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(190%) brightness(1.08);
    backdrop-filter: blur(20px) saturate(190%) brightness(1.08);
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.4),
      inset 0 -1px 0.5px rgba(255, 255, 255, 0.12),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05),
      0 1px 2px rgba(0, 0, 0, 0.35),
      0 18px 40px -14px rgba(0, 0, 0, 0.65);
    opacity: 0;
    /* tillbaka: först av allt */
    transition: opacity var(--nav-t-glass) var(--ease-out-quart) 0ms;
    will-change: opacity;
  }
  .nav-glass::before,
  .nav-glass::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }
  /* Specular: ljuset kommer snett uppifrån vänster */
  .nav-glass::before {
    background: radial-gradient(
      120% 100% at 18% -25%,
      rgba(255, 255, 255, 0.22),
      rgba(255, 255, 255, 0) 55%
    );
  }
  /* Brytningskant: bara ringen syns, via två masker som tar ut varandra */
  .nav-glass::after {
    padding: 7px;
    -webkit-backdrop-filter: blur(6px) brightness(1.35) saturate(1.5);
    backdrop-filter: blur(6px) brightness(1.35) saturate(1.5);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  /* --- Orb-läget --------------------------------------------------- */
  [data-orb] .nav-fade {
    opacity: 0;
    transition: opacity var(--nav-t-fade) linear 0ms; /* steg 1 */
  }
  [data-orb] .nav-collapse {
    grid-template-columns: 0fr;
    opacity: 0;
    transition:
      grid-template-columns var(--nav-t-morph) var(--ease-out-quart)
        var(--nav-t-fade),
      opacity var(--nav-t-fade) linear 0ms;
  }
  /* Med border-box sätter padding en golvbredd som överlever 0fr-kolumnen,
     så luckan blir bredare än spacern. Nolla den när innehållet viks ihop. */
  [data-orb] .nav-collapse > * {
    padding: 0;
    transition: padding var(--nav-t-morph) var(--ease-out-quart)
      var(--nav-t-fade);
  }
  [data-orb] .nav-spacer {
    min-width: var(--space-xl);
  }
  /* Luft innanför glaskanten, och orben lägger sig strax under skärmkanten
     i stället för att sitta klistrad mot den. */
  [data-orb] .nav-bar {
    max-width: var(--orb-w, 18rem);
    height: 3.5rem;
    padding-inline: 1.25rem 0.5rem;
    transform: translate3d(0, 8px, 0);
    transition:
      max-width var(--nav-t-morph) var(--ease-out-quart) var(--nav-t-fade),
      height var(--nav-t-morph) var(--ease-out-quart) var(--nav-t-fade),
      padding var(--nav-t-morph) var(--ease-out-quart) var(--nav-t-fade),
      transform var(--nav-t-morph) var(--ease-out-quart) var(--nav-t-fade);
  }
  [data-orb] .nav-glass {
    opacity: 1;
    pointer-events: auto;
    /* steg 3, med lite överlapp mot morfen så det inte känns hackigt */
    transition: opacity var(--nav-t-glass) var(--ease-out-quart)
      calc(var(--nav-t-fade) + var(--nav-t-morph) - 60ms);
  }

  /* Mätläge: sluttillståndet utan mellanliggande animering */
  [data-measuring] * {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-fade,
    .nav-bar,
    .nav-collapse,
    .nav-collapse > *,
    .nav-glass,
    [data-orb] .nav-fade,
    [data-orb] .nav-bar,
    [data-orb] .nav-collapse,
    [data-orb] .nav-collapse > *,
    [data-orb] .nav-glass {
      transition: none;
    }
  }
</style>

<script>
  // Full nav nära toppen, glasorb när man har scrollat förbi. Positionsstyrt,
  // inte riktningsstyrt: menyn ska inte försvinna, den ska byta skepnad.
  // Orben är desktop-only — på mobil finns varken meny eller Download att
  // vika ihop, så raden ser likadan ut i båda lägena.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const bar = document.querySelector<HTMLElement>(".nav-bar");
  const desktop = matchMedia("(min-width: 768px)");
  if (nav && bar) {
    const TOP = 80; // px från sidtoppen där hela navet visas
    let ticking = false;

    // Mät orbens bredd genom att kort slå på orb-läget med max-content och
    // transitions avstängda. CSS:en förblir sanningskällan för måtten -
    // alternativet vore att spegla padding och lucka som konstanter här.
    let measuring = false;
    const measure = () => {
      if (measuring) return;
      measuring = true;
      const wasOrb = nav.hasAttribute("data-orb");
      nav.setAttribute("data-measuring", "");
      nav.setAttribute("data-orb", "");
      bar.style.maxWidth = "max-content";
      const w = bar.getBoundingClientRect().width;
      bar.style.maxWidth = "";
      if (!wasOrb) nav.removeAttribute("data-orb");
      nav.offsetWidth; // tvinga omräkning innan transitions slås på igen
      nav.removeAttribute("data-measuring");
      nav.style.setProperty("--orb-w", Math.ceil(w) + "px");
      measuring = false;
    };

    const update = () => {
      nav.toggleAttribute("data-orb", desktop.matches && scrollY > TOP);
      ticking = false;
    };

    desktop.addEventListener("change", update);
    addEventListener("resize", measure, { passive: true });
    // Logotypens svg och webfonten landar efter första målningen, och innan
    // dess mäter vi en orb som är för smal. Observera de två elementen som
    // faktiskt bestämmer bredden i stället för att gissa när de är klara.
    const ro = new ResizeObserver(measure);
    document
      .querySelectorAll("[data-nav-logo], [data-nav-buy]")
      .forEach((el) => ro.observe(el));
    measure();
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

---
// Flytande blur-pill-nav (Mobbin). Sticky. Skuggan tonas in vid scroll.
const links = [
  { label: "Features", href: "#features" },
  { label: "Pricing", href: "#pricing" },
  { label: "Changelog", href: "#changelog" },
];
---

<header class="sticky top-4 z-50 px-[var(--spacing-gutter)]">
  <nav
    id="site-nav"
    data-scrolled="false"
    class="mx-auto flex max-w-3xl items-center justify-between gap-6 rounded-pill bg-[var(--nav-bg)] py-2.5 pr-2.5 pl-5 shadow-sm backdrop-blur-xl transition-shadow duration-300 ease-[var(--ease-out-quart)] data-[scrolled=true]:shadow-md"
  >
    <!-- Brand: "Dolly" rullar upp och ut, symbolen in underifrån, när hero-ikonen
         scrollat förbi. group/brand + data-swapped styr de två lagren. -->
    <a
      href="/"
      id="nav-brand"
      data-swapped="false"
      aria-label="Dolly"
      class="group/brand relative ml-1.5 inline-flex h-6 items-center overflow-hidden"
    >
      <span
        class="text-base font-semibold tracking-tight text-text transition-transform duration-300 ease-[var(--ease-out-quart)] group-data-[swapped=true]/brand:-translate-y-full"
      >
        Dolly
      </span>
      <span
        class="pointer-events-none absolute inset-0 flex translate-y-full items-center transition-transform duration-300 ease-[var(--ease-out-quart)] group-data-[swapped=true]/brand:translate-y-0"
        aria-hidden="true"
      >
        <img src="/dolly-logo-single.svg" alt="" class="h-5 w-auto" />
      </span>
    </a>
    <ul class="hidden items-center gap-6 text-sm text-text-muted sm:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="transition-colors hover:text-text">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="#"
      class="rounded-pill bg-btn-primary px-4 py-2 text-sm font-medium text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
    >
      Download
    </a>
  </nav>
</header>

<script>
  const nav = document.getElementById("site-nav");
  const onScroll = () =>
    nav?.setAttribute("data-scrolled", String(window.scrollY > 8));
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });

  // Brand-växling: byt "Dolly" mot symbolen när hero-appikonen lämnat vyn
  // (bakom navet). IntersectionObserver → symmetrisk åt båda scrollhåll.
  const brand = document.getElementById("nav-brand");
  const heroIcon = document.getElementById("hero-app-icon");
  if (brand && heroIcon) {
    const io = new IntersectionObserver(
      ([entry]) =>
        brand.setAttribute("data-swapped", String(!entry.isIntersecting)),
      { rootMargin: "-80px 0px 0px 0px", threshold: 0 },
    );
    io.observe(heroIcon);
  }
</script>
